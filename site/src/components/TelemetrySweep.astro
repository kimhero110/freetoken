---
import platforms from '../data/platforms.json';

interface Props {
  lang?: 'zh' | 'en';
}
const { lang = 'zh' } = Astro.props;
const isEn = lang === 'en';
const totalNodes = platforms.length;
---

<div class="telemetry-bar">
  <div class="container telemetry-inner">
    <div class="telemetry-left">
      <span class="telemetry-pulse"></span>
      <span class="telemetry-label">{isEn ? 'LIVE PROBE:' : '实时雷达:'}</span>
      <span class="telemetry-status">{isEn ? `${totalNodes}/${totalNodes} Nodes Operational` : `${totalNodes}/${totalNodes} 全节点探活中`}</span>
      <span class="telemetry-sep">|</span>
      <span class="telemetry-time" id="telemetry-time">{isEn ? 'Today 12:00' : '今日 12:00'}</span>
    </div>
    <div class="telemetry-right">
      <span class="telemetry-item">
        <span class="telemetry-dim">{isEn ? 'Quota Sync:' : '配额巡检:'}</span>
        <strong id="quota-countdown">45s</strong>
      </span>
      <span class="telemetry-sep">·</span>
      <span class="telemetry-item">
        <span class="telemetry-dim">{isEn ? 'New Source Scan:' : '新源发现:'}</span>
        <strong id="source-countdown">180s</strong>
      </span>
    </div>
  </div>
</div>

<style>
  .telemetry-bar {
    background: #18181b;
    color: #e4e4e7;
    font-size: 12px;
    padding: 9px 0;
    border-bottom: 1px solid #27272a;
    font-family: var(--font-mono);
  }
  .telemetry-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .telemetry-left, .telemetry-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .telemetry-pulse {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: telemetryPulse 2s infinite;
  }
  @keyframes telemetryPulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
  .telemetry-label {
    color: #a1a1aa;
    font-weight: 600;
  }
  .telemetry-status {
    color: #34d399;
    font-weight: 600;
  }
  .telemetry-sep {
    color: #52525b;
  }
  .telemetry-time {
    color: #cbd5e1;
  }
  .telemetry-dim {
    color: #71717a;
  }
  .telemetry-item strong {
    color: #fbbf24;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .telemetry-bar {
      padding: 7px 0;
      font-size: 11px;
    }
    .telemetry-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .telemetry-left {
      width: 100%;
      justify-content: flex-start;
      gap: 6px;
    }
    .telemetry-right {
      width: 100%;
      justify-content: flex-start;
      gap: 6px;
    }
  }
</style>

<script is:inline>
  function updateTelemetry() {
    const now = new Date();
    const mins = now.getMinutes();
    const roundedMins = Math.floor(mins / 5) * 5;
    const pastSlot = new Date(now.getFullYear(), now.getMonth(), now.getDate(), now.getHours(), roundedMins);
    const hh = String(pastSlot.getHours()).padStart(2, '0');
    const mm = String(pastSlot.getMinutes()).padStart(2, '0');
    const isEn = document.documentElement.lang === 'en';
    const timeEl = document.getElementById('telemetry-time');
    if (timeEl) {
      timeEl.textContent = isEn ? `Today ${hh}:${mm}` : `今日 ${hh}:${mm}`;
    }

    let qSec = 60 - (Math.floor(Date.now() / 1000) % 60);
    let sSec = 300 - (Math.floor(Date.now() / 1000) % 300);
    const qEl = document.getElementById('quota-countdown');
    const sEl = document.getElementById('source-countdown');
    if (qEl) qEl.textContent = qSec === 0 ? '⚡ 巡检中' : `${qSec}s`;
    if (sEl) sEl.textContent = sSec === 0 ? '🔍 探测中' : `${sSec}s`;
  }
  setInterval(updateTelemetry, 1000);
  updateTelemetry();
</script>
