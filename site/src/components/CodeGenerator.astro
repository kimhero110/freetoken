---
import { getCompatiblePlatforms, getToolState, VERIFICATION_LABELS } from '../lib/operation-generator.mjs';

interface Props {
  platforms: any[];
  lang?: 'zh' | 'en';
}

const { platforms = [], lang = 'zh' } = Astro.props;
const isEn = lang === 'en';
const compatiblePlatforms = getCompatiblePlatforms(platforms);
const first = compatiblePlatforms[0];
const tabs = [
  { id: 'curl', tool: 'curl', label: 'cURL', file: 'request.sh' },
  { id: 'python', tool: 'openai_python', label: 'Python SDK', file: 'request.py' },
  { id: 'node', tool: 'openai_node', label: 'Node.js SDK', file: 'request.mjs' },
  { id: 'openclaw', tool: 'openclaw', label: 'OpenClaw', file: '' },
  { id: 'cursor', tool: 'cursor', label: 'Cursor / Cline', file: '' },
  { id: 'cherry', tool: 'cherry_studio', label: 'Cherry Studio', file: '' },
  { id: 'freellmapi', tool: 'freellmapi', label: 'FreeLLMAPI', file: 'local-channel.json' },
];
const firstEnabledTab = tabs.find((tab) => first && getToolState(first.tools, tab.tool, lang).enabled);
const serializedPlatforms = JSON.stringify(compatiblePlatforms);
const labels = {
  empty: isEn ? 'No executable OpenAI Chat Completions operations are currently available.' : '当前没有可执行的 OpenAI Chat Completions 操作。',
  select: isEn ? 'Platform and operation' : '平台与操作',
  model: isEn ? 'Canonical model' : '规范模型',
  copy: isEn ? 'Copy code' : '复制代码',
  copied: isEn ? 'Copied' : '已复制',
  env: isEn ? 'Set the shown environment variable before running. API keys are never entered or rendered on this page.' : '运行前请设置代码中显示的环境变量。本页不输入、不渲染 API Key。',
  retry: isEn
    ? 'Examples use one POST attempt with a 30-second timeout. Automatic retries are disabled because they can duplicate billable calls. Output is bounded with max_tokens=64.'
    : '示例仅发送一次 POST，请求超时为 30 秒。自动重试已禁用，避免重复计费调用。输出通过 max_tokens=64 控制。',
};
---

<div class="config-generator-card" id="code-generator" data-lang={lang} data-platforms={serializedPlatforms}>
  <header class="generator-header">
    <div>
      <p class="eyebrow">OPENAI CHAT COMPLETIONS</p>
      <h2>{isEn ? 'Verified integration generator' : '已核验接入代码生成器'}</h2>
      <p>{isEn ? 'Only documented or recently live-tested v2 operations produce executable examples.' : '仅为已核查文档或近期真实调用通过的 v2 操作生成可执行示例。'}</p>
    </div>
    {first && <span id="operation-badge" class={`verification-badge level-${first.operation.verification.status}`}>
      {VERIFICATION_LABELS[lang][first.operation.verification.status]}
    </span>}
  </header>

  {compatiblePlatforms.length === 0 ? (
    <p class="empty-state" role="status">{labels.empty}</p>
  ) : (
    <>
      <div class="gen-controls-grid">
        <div class="control-group">
          <label for="select-platform">{labels.select}</label>
          <select id="select-platform">
            {compatiblePlatforms.map((platform) => (
              <option value={platform.slug}>
                {isEn ? platform.name_en || platform.name : platform.name} · {platform.operation.verification.status}
              </option>
            ))}
          </select>
        </div>
        <div class="control-group">
          <label for="select-model">{labels.model}</label>
          <select id="select-model">
            {first?.operation.models.map((model) => <option value={model}>{model}</option>)}
          </select>
        </div>
      </div>

      <p class="secret-guidance">{labels.env}</p>

      <div class="gen-tabs-wrap">
        <div class="code-gen-tabs" id="gen-tabs" role="tablist" aria-label={isEn ? 'Generated format' : '生成格式'}>
          {tabs.map((tab) => {
            const state = getToolState(first?.tools, tab.tool, lang);
            const active = tab.id === firstEnabledTab?.id;
            return <button
              id={`gen-tab-${tab.id}`}
              class:list={['code-gen-tab', { active }]}
              data-tab={tab.id}
              data-tool={tab.tool}
              data-label={tab.label}
              data-file={tab.file}
              type="button"
              role="tab"
              aria-selected={active ? 'true' : 'false'}
              aria-controls="generated-code"
              aria-describedby="tool-support-message"
              aria-disabled={!state.enabled ? 'true' : 'false'}
               tabindex={active ? '0' : '-1'}
              title={state.reason}
            >{tab.label}{!state.enabled ? ` · ${isEn ? 'unavailable' : '不可用'}` : ''}</button>;
          })}
        </div>
      </div>

      <p id="tool-support-message" class="support-message" aria-live="polite">
        {firstEnabledTab ? getToolState(first?.tools, firstEnabledTab.tool, lang).reason : labels.empty}
      </p>
      <p id="app-support-message" class="app-support-message" aria-live="polite">
        {tabs.filter((tab) => !getToolState(first?.tools, tab.tool, lang).enabled).map((tab) => `${tab.label}: ${getToolState(first?.tools, tab.tool, lang).reason}`).join(' · ')}
      </p>
      <p class="reliability-note">{labels.retry}</p>

      <div class="gen-output-container" id="generated-code" role="tabpanel" aria-labelledby={`gen-tab-${firstEnabledTab?.id}`}>
        <div class="output-topbar">
          <span id="output-file-name">{firstEnabledTab?.file}</span>
          <button type="button" id="btn-copy-code">{labels.copy}</button>
        </div>
        <pre><code id="code-output-text"></code></pre>
      </div>
    </>
  )}
</div>

<style>
  .config-generator-card { background:#fff; border:2px solid var(--text); border-radius:12px; padding:28px; box-shadow:0 12px 32px rgba(0,0,0,.06); margin-bottom:40px; }
  .generator-header { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; border-bottom:1px solid var(--card-border); padding-bottom:18px; margin-bottom:20px; }
  .generator-header h2 { font-size:21px; margin:2px 0 5px; }
  .generator-header p { color:var(--text-muted); font-size:13.5px; line-height:1.5; }
  .eyebrow { font-family:var(--font-mono); font-size:10px !important; font-weight:700; letter-spacing:.12em; color:var(--accent) !important; }
  .verification-badge { flex:0 0 auto; max-width:240px; padding:5px 9px; border-radius:5px; font-size:11px; font-weight:700; background:#fffbeb; border:1px solid #fde68a; color:#92400e; }
  .level-documented,.level-live { background:#f0fdf4; border-color:#bbf7d0; color:#166534; }
  .gen-controls-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:14px; }
  .control-group { display:flex; flex-direction:column; gap:6px; }
  .control-group label { font-size:12px; font-weight:700; color:var(--text-muted); }
  select { width:100%; padding:10px 12px; border:1px solid var(--card-border); border-radius:6px; background:#fff; color:var(--text); font-size:13.5px; }
  select:focus-visible,.code-gen-tab:focus-visible,button:focus-visible { outline:3px solid rgba(37,99,235,.3); outline-offset:2px; }
  .secret-guidance,.reliability-note,.support-message,.app-support-message { font-size:12.5px; line-height:1.55; }
  .secret-guidance { padding:10px 12px; margin-bottom:16px; background:#eff6ff; border-left:3px solid #2563eb; color:#1e3a8a; }
  .gen-tabs-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:thin; padding-bottom:6px; }
  .code-gen-tabs { display:flex; gap:7px; min-width:max-content; }
  .code-gen-tab { border:1px solid var(--card-border); border-radius:6px; background:var(--bg-subtle); color:var(--text-muted); padding:7px 12px; font-size:12px; font-weight:650; cursor:pointer; }
  .code-gen-tab.active { background:var(--text); color:#fff; border-color:var(--text); }
   .code-gen-tab[aria-disabled="true"] { cursor:not-allowed; opacity:.55; text-decoration:line-through; }
  .support-message { min-height:20px; margin:6px 0 0; color:var(--text-muted); font-weight:600; }
  .app-support-message { margin:5px 0 0; color:var(--text-muted); }
  .reliability-note { margin:7px 0 16px; color:#7c2d12; }
  .gen-output-container { background:#18181b; border:1px solid #27272a; border-radius:8px; overflow:hidden; }
  .output-topbar { display:flex; justify-content:space-between; align-items:center; padding:8px 14px; background:#27272a; color:#a1a1aa; font:600 12px var(--font-mono); }
  #btn-copy-code { border:0; border-radius:4px; background:#3f3f46; color:#f4f4f5; padding:6px 11px; cursor:pointer; }
  pre { margin:0; padding:17px; overflow:auto; }
  code { color:#bae6fd; font:12.5px/1.62 var(--font-mono); white-space:pre; }
  .empty-state { padding:20px; background:var(--bg-subtle); border:1px solid var(--card-border); color:var(--text-muted); }
  @media (max-width:700px) { .config-generator-card{padding:19px 14px}.generator-header{display:block}.verification-badge{display:inline-block;margin-top:12px}.gen-controls-grid{grid-template-columns:1fr} }
</style>

<script>
  import { generateSnippet, getToolState, VERIFICATION_LABELS } from '../lib/operation-generator.mjs';

  const root = document.getElementById('code-generator');
  if (root instanceof HTMLElement && root.dataset.platforms) {
    const lang = root.dataset.lang === 'zh' ? 'zh' : 'en';
    const platforms = JSON.parse(root.dataset.platforms);
    const platformSelect = root.querySelector<HTMLSelectElement>('#select-platform');
    const modelSelect = root.querySelector<HTMLSelectElement>('#select-model');
    const output = root.querySelector('#code-output-text');
    const panel = root.querySelector('#generated-code');
    const badge = root.querySelector('#operation-badge');
    const supportMessage = root.querySelector('#tool-support-message');
    const appSupportMessage = root.querySelector('#app-support-message');
    const fileName = root.querySelector('#output-file-name');
    const copyButton = root.querySelector<HTMLButtonElement>('#btn-copy-code');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.code-gen-tab')];
    const isEnabled = (tab: HTMLButtonElement) => tab.getAttribute('aria-disabled') !== 'true';
    let activeTab = tabs.find(isEnabled)?.dataset.tab || '';

    const selectedPlatform = () => platforms.find((item) => item.slug === platformSelect?.value) || platforms[0];
    const enabledTabs = () => tabs.filter(isEnabled);

    function selectTab(tab) {
      if (!tab || !isEnabled(tab)) return;
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle('active', active);
        item.setAttribute('aria-selected', String(active));
        item.tabIndex = active ? 0 : -1;
      });
      activeTab = tab.dataset.tab || '';
      panel?.setAttribute('aria-labelledby', tab.id);
      if (fileName) fileName.textContent = tab.dataset.file || '';
      render();
    }

    function updatePlatform() {
      const platform = selectedPlatform();
      if (!platform) return;
      if (modelSelect) {
        modelSelect.replaceChildren(...platform.operation.models.map((model) => {
          const option = document.createElement('option');
          option.value = model;
          option.textContent = model;
          return option;
        }));
      }
      if (badge) {
        badge.textContent = VERIFICATION_LABELS[lang][platform.operation.verification.status];
        badge.className = `verification-badge level-${platform.operation.verification.status}`;
      }
      tabs.forEach((tab) => {
        const state = getToolState(platform.tools, tab.dataset.tool, lang);
        tab.setAttribute('aria-disabled', String(!state.enabled));
        tab.title = state.reason;
      });
      if (appSupportMessage) {
        appSupportMessage.textContent = tabs
          .filter((tab) => !getToolState(platform.tools, tab.dataset.tool, lang).enabled)
          .map((tab) => `${tab.dataset.label}: ${getToolState(platform.tools, tab.dataset.tool, lang).reason}`)
          .join(' · ');
      }
      let active = tabs.find((tab) => tab.dataset.tab === activeTab && isEnabled(tab));
      if (!active) active = enabledTabs()[0];
      selectTab(active);
    }

    function render() {
      const platform = selectedPlatform();
      const tab = tabs.find((item) => item.dataset.tab === activeTab);
      if (!platform || !tab || !output) return;
      const state = getToolState(platform.tools, tab.dataset.tool, lang);
      if (supportMessage) supportMessage.textContent = state.reason;
      output.textContent = generateSnippet(platform.operation, modelSelect?.value, activeTab);
    }

    platformSelect?.addEventListener('change', updatePlatform);
    modelSelect?.addEventListener('change', render);
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        const available = enabledTabs();
        const index = available.indexOf(tab);
        let next;
        if (event.key === 'ArrowRight') next = available[(index + 1) % available.length];
        if (event.key === 'ArrowLeft') next = available[(index - 1 + available.length) % available.length];
        if (event.key === 'Home') next = available[0];
        if (event.key === 'End') next = available.at(-1);
        if (next) { event.preventDefault(); selectTab(next); next.focus(); }
      });
    });
    copyButton?.addEventListener('click', async () => {
      const original = lang === 'zh' ? '复制代码' : 'Copy code';
      try {
        if (!navigator.clipboard) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(output?.textContent || '');
        copyButton.textContent = lang === 'zh' ? '已复制' : 'Copied';
      } catch {
        copyButton.textContent = lang === 'zh' ? '复制失败，请手动选择' : 'Copy failed; select manually';
        copyButton.setAttribute('aria-live', 'polite');
      }
      window.setTimeout(() => { copyButton.textContent = original; }, 1600);
    });
    updatePlatform();
  }
</script>
