---
import Base from '../../layouts/Base.astro';
import articles from '../../data/articles.json';
import { marked } from 'marked';

export async function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const htmlContent = marked.parse(article.content_md);

// Extract headings for Table of Contents
const headingMatches = [...article.content_md.matchAll(/^(#{2,3})\s+(.+)$/gm)];
const toc = headingMatches.map((m) => {
  const level = m[1].length;
  const rawText = m[2].trim();
  const id = rawText.toLowerCase().replace(/[^\w\u4e00-\u9fa5]+/g, '-').replace(/^-+|-+$/g, '');
  return { level, text: rawText, id };
});

// Related articles
const relatedArticles = articles.filter((a) => a.slug !== article.slug).slice(0, 2);
---

<Base
  title={`${article.title} · FreeToken 深度文章`}
  description={article.summary}
  lang="zh"
>
  <article class="article-detail-page">
    <div class="container article-layout">
      
      <!-- 主内容区 -->
      <main class="article-main">
        <!-- 面包屑导航 -->
        <nav class="article-breadcrumb">
          <a href="/">算力雷达</a>
          <span class="bc-sep">/</span>
          <a href="/articles/">深度文章</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{article.category}</span>
        </nav>

        <header class="article-header">
          <div class="article-meta-top">
            <span class="article-cat-tag">{article.category}</span>
            <span class="article-read-badge">{article.reading_time}</span>
          </div>

          <h1 class="article-main-title">{article.title}</h1>

          <div class="article-author-bar">
            <span class="author-name">✍️ {article.author}</span>
            <span class="meta-dot">·</span>
            <span class="publish-date">发布于 {article.date}</span>
            {article.updated && article.updated !== article.date && (
              <>
                <span class="meta-dot">·</span>
                <span class="update-date">更新于 {article.updated}</span>
              </>
            )}
          </div>
        </header>

        <!-- Markdown 渲染内容主体 -->
        <div class="article-content-body" set:html={htmlContent} />

        <!-- 底部版权与分享卡片 -->
        <div class="article-footer-card">
          <div class="footer-card-copy">
            <h4>💡 觉得有收获？</h4>
            <p>欢迎关注公众号【FreeToken 免费情报局】，获取全球一手免费算力与 Agent 提效内参。</p>
          </div>
          <button class="btn-open-wechat-sub open-wechat-trigger">关注公众号 ↗</button>
        </div>

        <!-- 底部相关文章 -->
        {relatedArticles.length > 0 && (
          <div class="related-articles-section">
            <h3 class="related-title">延伸阅读推荐</h3>
            <div class="related-grid">
              {relatedArticles.map((rel) => (
                <a href={`/article/${rel.slug}/`} class="related-card">
                  <span class="rel-cat">{rel.category}</span>
                  <h4>{rel.title}</h4>
                  <span class="rel-time">{rel.reading_time}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="article-back-nav">
          <a href="/articles/" class="btn-back">← 返回文章专栏大厅</a>
          <a href="/guide/" class="btn-back">📖 查看 10 秒代码生成器 →</a>
        </div>
      </main>

      <!-- 侧边栏：TOC 目录与快捷操作 -->
      <aside class="article-sidebar">
        <div class="sidebar-sticky-box">
          <div class="toc-card">
            <div class="toc-header">
              <span class="toc-icon">📑</span>
              <span class="toc-title">文章目录</span>
            </div>
            <nav class="toc-list">
              {toc.map((item) => (
                <a
                  href={`#${item.id}`}
                  class={`toc-item toc-level-${item.level}`}
                >
                  {item.text}
                </a>
              ))}
            </nav>
          </div>

          <div class="sidebar-action-card">
            <h4>⚡ 算力调度实验室</h4>
            <p>10 秒生成 40+ 家平台 OpenAI 兼容配置代码。</p>
            <a href="/guide/" class="btn-sidebar-guide">立即生成配置 ↗</a>
          </div>
        </div>
      </aside>

    </div>
  </article>

  <style>
    .article-detail-page {
      padding: 44px 0 64px;
      background: #ffffff;
    }
    .article-layout {
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 48px;
      align-items: flex-start;
    }
    @media (max-width: 900px) {
      .article-layout {
        grid-template-columns: 1fr;
      }
      .article-sidebar {
        display: none;
      }
    }

    /* 面包屑 */
    .article-breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12.5px;
      color: var(--text-light);
      margin-bottom: 20px;
    }
    .article-breadcrumb a {
      color: var(--text-muted);
      transition: color 0.15s;
    }
    .article-breadcrumb a:hover {
      color: var(--text);
    }
    .bc-sep {
      opacity: 0.4;
    }
    .bc-current {
      color: var(--accent);
      font-weight: 600;
    }

    .article-header {
      margin-bottom: 32px;
      border-bottom: 1px solid var(--card-border);
      padding-bottom: 24px;
    }
    .article-meta-top {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
    }
    .article-cat-tag {
      font-size: 11px;
      font-weight: 700;
      color: var(--accent);
      background: rgba(37, 99, 235, 0.08);
      border: 1px solid rgba(37, 99, 235, 0.2);
      padding: 2px 8px;
      border-radius: 4px;
    }
    .article-read-badge {
      font-size: 12px;
      color: var(--text-light);
    }
    .article-main-title {
      font-size: clamp(24px, 4vw, 34px);
      font-weight: 800;
      line-height: 1.3;
      letter-spacing: -0.6px;
      color: var(--text);
      margin-bottom: 14px;
    }
    .article-author-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--text-muted);
    }
    .meta-dot {
      opacity: 0.4;
    }

    /* 正文样式 */
    .article-content-body {
      font-size: 15.5px;
      line-height: 1.8;
      color: var(--text);
    }
    .article-content-body :global(h2) {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.4px;
      margin: 36px 0 16px;
      border-bottom: 1px solid var(--card-border);
      padding-bottom: 10px;
      scroll-margin-top: 80px;
    }
    .article-content-body :global(h3) {
      font-size: 17.5px;
      font-weight: 700;
      margin: 28px 0 12px;
      scroll-margin-top: 80px;
    }
    .article-content-body :global(p) {
      margin-bottom: 18px;
    }
    .article-content-body :global(blockquote) {
      background: var(--bg-subtle);
      border-left: 4px solid var(--accent);
      padding: 14px 18px;
      border-radius: 0 8px 8px 0;
      margin: 20px 0;
      font-size: 14.5px;
      color: var(--text-muted);
    }
    .article-content-body :global(ul), .article-content-body :global(ol) {
      padding-left: 22px;
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .article-content-body :global(pre) {
      background: #18181b;
      color: #e4e4e7;
      padding: 16px 18px;
      border-radius: 8px;
      font-family: var(--font-mono);
      font-size: 13px;
      line-height: 1.6;
      overflow-x: auto;
      margin: 20px 0;
      border: 1px solid #27272a;
    }
    .article-content-body :global(code) {
      font-family: var(--font-mono);
      font-size: 13px;
      background: var(--bg-subtle);
      color: var(--accent);
      padding: 2px 6px;
      border-radius: 4px;
    }
    .article-content-body :global(pre code) {
      background: transparent;
      color: inherit;
      padding: 0;
    }

    /* 底部卡片 */
    .article-footer-card {
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 24px;
      margin: 40px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }
    .footer-card-copy h4 {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .footer-card-copy p {
      font-size: 13px;
      color: var(--text-muted);
    }
    .btn-open-wechat-sub {
      background: var(--text);
      color: #ffffff;
      border: none;
      font-size: 13px;
      font-weight: 600;
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
    }

    /* 延伸推荐 */
    .related-articles-section {
      margin-bottom: 36px;
    }
    .related-title {
      font-size: 16.5px;
      font-weight: 700;
      margin-bottom: 16px;
    }
    .related-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    @media (max-width: 600px) {
      .related-grid { grid-template-columns: 1fr; }
    }
    .related-card {
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 16px;
      transition: all 0.15s;
    }
    .related-card:hover {
      border-color: var(--text);
      background: #ffffff;
      transform: translateY(-2px);
    }
    .rel-cat {
      font-size: 10.5px;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 4px;
      display: block;
    }
    .related-card h4 {
      font-size: 13.5px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 6px;
      line-height: 1.4;
    }
    .rel-time {
      font-size: 11px;
      color: var(--text-light);
    }

    .article-back-nav {
      display: flex;
      justify-content: space-between;
      border-top: 1px solid var(--card-border);
      padding-top: 24px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .btn-back {
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
      border: 1px solid var(--card-border);
      padding: 6px 14px;
      border-radius: 6px;
      transition: all 0.15s;
    }
    .btn-back:hover {
      background: var(--text);
      color: #ffffff;
    }

    /* 侧边栏 */
    .sidebar-sticky-box {
      position: sticky;
      top: 32px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .toc-card {
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 18px;
    }
    .toc-header {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 12px;
      border-bottom: 1px solid var(--card-border);
      padding-bottom: 8px;
    }
    .toc-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .toc-item {
      font-size: 12.5px;
      color: var(--text-muted);
      line-height: 1.4;
      transition: color 0.15s;
    }
    .toc-item:hover {
      color: var(--text);
      font-weight: 600;
    }
    .toc-level-3 {
      padding-left: 12px;
      font-size: 11.5px;
      color: var(--text-light);
    }
    .sidebar-action-card {
      background: #ffffff;
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 18px;
    }
    .sidebar-action-card h4 {
      font-size: 13.5px;
      font-weight: 700;
      margin-bottom: 6px;
    }
    .sidebar-action-card p {
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 12px;
      line-height: 1.5;
    }
    .btn-sidebar-guide {
      display: inline-block;
      width: 100%;
      text-align: center;
      background: var(--accent);
      color: #ffffff;
      font-size: 12px;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 6px;
      transition: opacity 0.15s;
    }
    .btn-sidebar-guide:hover {
      opacity: 0.9;
    }
  </style>

  <script is:inline>
    document.querySelectorAll('.open-wechat-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('btn-open-wechat')?.click();
      });
    });
  </script>
</Base>
