---
// FreeTokens.info English Homepage (40+ Platforms with verified badges & real-time radar)
import Base from '../../layouts/Base.astro';
import platforms from '../../data/platforms.json';

function formatQuota(p: any): string {
  const q = p.free_quota;
  if (!q || q.amount == null) return 'No explicit quota';
  return `${q.amount} ${q.unit ?? ''}`.trim();
}

function formatVerified(dateStr: any): string {
  return dateStr || '2026-09-02';
}

const totalCount = platforms.length;
---
<Base lang="en">
  <!-- 1. Hero Section (Dual-track Carousel: 01 Free Tier Radar | 02 Pro Developer Lab) -->
  <section class="hero-editorial" id="hero-editorial">
    <div class="container hero-editorial-inner">
      <div class="hero-copy">
        
        <!-- Search Box: Top interactive slot -->
        <div class="hero-search-wrap">
          <input
            type="text"
            id="search-input"
            class="hero-search-input"
            placeholder="Search 40+ providers, models (Grok, Gemini, DeepSeek, StepFun) or features..."
            autocomplete="off"
          />
        </div>

        <!-- Segmented Mode Switcher -->
        <div class="hero-track-switcher">
          <button class="track-tab active" data-slide="0" id="tab-slide-0">
            <span class="track-num">01</span>
            <span>Free Tier Radar</span>
          </button>
          <button class="track-tab" data-slide="1" id="tab-slide-1">
            <span class="track-num">02</span>
            <span>Pro Developer Lab ↗</span>
          </button>
          <div class="track-progress-bar">
            <div class="track-progress-inner" id="track-progress-inner"></div>
          </div>
        </div>

        <!-- Slides Wrapper -->
        <div class="hero-slides-wrapper">
          
          <!-- Slide 0: Free Tier Radar -->
          <div class="hero-slide active" id="hero-slide-0">
            <p class="hero-eyebrow">Solopreneurs · AI Compute & Open Intelligence</p>
            <h1 class="hero-headline">
              Build with free tokens,<br/>
              and never stop thinking.
            </h1>
            <p class="hero-lead">
              Curated free API tiers and token credits across 40+ global LLM platforms. Transparent limits and 10-second drop-in integration code.
            </p>

            <!-- Neutral Telemetry Bar (Dynamic live sweep) -->
            <div class="radar-telemetry-bar">
              <div class="telemetry-item">
                <span class="telemetry-pulse"></span>
                <span class="telemetry-label">Status</span>
                <span class="telemetry-value">{totalCount}/{totalCount} Online</span>
              </div>
              <div class="telemetry-divider"></div>
              <div class="telemetry-item">
                <span class="telemetry-label">Sweep</span>
                <span id="telemetry-last-sweep" class="telemetry-value">Live Sync</span>
              </div>
              <div class="telemetry-divider"></div>
              <div class="telemetry-item">
                <span class="telemetry-label">Quota Check</span>
                <span id="radar-live-countdown" class="telemetry-timer">00:59</span>
              </div>
              <div class="telemetry-divider"></div>
              <div class="telemetry-item">
                <span class="telemetry-label">Radar Discovery</span>
                <span id="radar-discover-countdown" class="telemetry-timer">04:59</span>
              </div>
            </div>

            <!-- Key Links -->
            <div class="quick-index-bar">
              <span class="quick-index-label">Key Providers</span>
              <div class="quick-index-links">
                <a href="/en/platform/xai-grok/" class="quick-link">xAI Grok · $150/mo</a>
                <a href="/en/platform/google-ai-studio/" class="quick-link">Gemini · 1500 req/day</a>
                <a href="/en/platform/volcengine/" class="quick-link">Volcengine · 2M/day</a>
                <a href="/en/platform/stepfun/" class="quick-link">StepFun · 15 RMB</a>
                <a href="/en/platform/groq/" class="quick-link">Groq · Ultra-Fast</a>
              </div>
            </div>

            <div class="hero-actions">
              <a class="btn-hero-primary" href="#products">Explore All 40+ Providers ↓</a>
              <a class="btn-hero-secondary" href="/en/guide/">📖 Practice Playbook ↗</a>
              <a class="btn-hero-secondary" href="https://github.com/kimhero110/freetoken" target="_blank" rel="noopener">GitHub ↗</a>
            </div>
          </div>

          <!-- Slide 1: Pro Developer Lab -->
          <div class="hero-slide" id="hero-slide-1">
            <p class="hero-eyebrow hero-eyebrow-lab">Heavy Productivity · Commercial Compute</p>
            <h1 class="hero-headline">
              I am a professional developer,<br/>
              I need cost-effective, bulletproof tokens.
            </h1>
            <p class="hero-lead">
              For serious production workflows and agent automation: low-latency native US-server Claude 3.5 & Codex access via remote apps, plus enterprise volume discounts.
            </p>

            <!-- Highlights -->
            <div class="lab-highlights-grid">
              <div class="lab-highlight-item">
                <span class="lab-highlight-badge">Native US</span>
                <span class="lab-highlight-text">Claude 3.5 Sonnet / Opus native server anti-ban channels</span>
              </div>
              <div class="lab-highlight-item">
                <span class="lab-highlight-badge">Agent Ready</span>
                <span class="lab-highlight-text">Codex & Cursor 24/7 low-latency coding infrastructure</span>
              </div>
              <div class="lab-highlight-item">
                <span class="lab-highlight-badge">Discounts</span>
                <span class="lab-highlight-text">Volume wholesale discounts on top foundation models</span>
              </div>
            </div>

            <div class="hero-actions">
              <a class="btn-hero-primary btn-hero-lab" href="https://freetokenlab.com" target="_blank" rel="noopener">
                Visit FreeToken Lab ↗
              </a>
              <a class="btn-hero-secondary" href="/en/guide/">View Architecture ↗</a>
            </div>
          </div>

        </div>
      </div>

      <!-- Right mascot card -->
      <div class="hero-mascot-wrapper">
        <div class="hero-card-mascot">
          <img src="/images/hero-mascot.webp" alt="Thinking Cyber Owl Artwork" class="hero-mascot-img" width="380" height="380" />
          <div class="mascot-caption">
            <p>Tools make you fast; thinking decides your direction.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Platform Directory -->
  <section class="section-wrap section-bg" id="products">
    <div class="container">
      <header class="section-head">
        <p class="section-eyebrow">RADAR DIRECTORY</p>
        <h2 class="section-title">Global LLM & Cloud API Free Tiers (40+ Platforms)</h2>
      </header>

      <!-- Category Tabs -->
      <div class="filter-pills" id="filter-tabs">
        <button class="filter-pill active" data-filter="all">All ({totalCount})</button>
        <button class="filter-pill" data-filter="limited">Promotional</button>
        <button class="filter-pill" data-filter="permanent">Foundation Free</button>
        <button class="filter-pill" data-filter="daily">Daily Reset</button>
        <button class="filter-pill" data-filter="domestic">Direct CN</button>
        <button class="filter-pill" data-filter="tools">Dev & Search</button>
        <button class="filter-pill" data-filter="multimodal">Multimodal</button>
        <button class="filter-pill" data-filter="web3">Web3 Faucet</button>
      </div>

      <!-- Grid -->
      <div class="editorial-grid" id="platform-grid">
        {platforms.map((p) => {
          const q = p.free_quota ?? {};
          const qType = String(q.type || '');
          const qReset = String(q.reset_period || '');
          const tags = Array.isArray(p.tags) ? p.tags : [];
          const tagsStr = tags.join(' ');

          const isLimited = tags.includes('限时') || tags.includes('体验金') || qType.includes('限时') || qType.includes('体验') || qType.includes('赠送') || qType.includes('优惠') || qType.includes('补贴');
          const isPermanent = tags.includes('永久') || tags.includes('免费层') || qType.includes('永久') || qType.includes('完全') || qType.includes('免费层');
          const isDaily = tags.includes('每日') || tags.includes('每月') || qType.includes('每日') || qType.includes('每小时') || qType.includes('每月') || qReset.includes('日') || qReset.includes('小时') || qReset.includes('月');
          const isDomestic = p.category === '国内主流' || p.category === '大厂云服务' || tags.includes('国产直连') || tags.includes('国内直连');
          const isTools = p.category === '搜索与工具' || p.slug === 'tavily' || p.slug === 'jina-ai';
          const isMultimodal = p.category === '多模态/工具' || p.category === '多模态' || p.slug === 'pollinations';
          const isWeb3 = p.category === '区块链水龙头' || p.slug === 'sepolia-faucet';

          return (
            <a
              class="editorial-card"
              href={`/en/platform/${p.slug}/`}
              data-limited={isLimited ? "true" : "false"}
              data-permanent={isPermanent ? "true" : "false"}
              data-daily={isDaily ? "true" : "false"}
              data-domestic={isDomestic ? "true" : "false"}
              data-tools={isTools ? "true" : "false"}
              data-multimodal={isMultimodal ? "true" : "false"}
              data-web3={isWeb3 ? "true" : "false"}
              data-search={`${p.name} ${p.name_en ?? ''} ${p.slug} ${p.intro_en ?? p.intro ?? ''} ${tagsStr}`.toLowerCase()}
            >
              <div class="card-main-content">
                <div class="card-meta-top">
                  <span class="card-category">{p.category}</span>
                  {isLimited && <span class="badge-tag badge-limited">PROMO</span>}
                  {isDaily && <span class="badge-tag badge-daily">DAILY</span>}
                  {isPermanent && <span class="badge-tag badge-permanent">FREE</span>}
                  {isDomestic && <span class="badge-tag badge-domestic">DIRECT CN</span>}
                </div>

                <h3 class="card-title">
                  {p.name_en || p.name}
                  {p.name_en && p.name !== p.name_en && <small class="card-name-en">{p.name}</small>}
                </h3>

                <div class="card-quota-box">
                  <div class="quota-label">FREE TIER / CREDITS</div>
                  <div class="quota-amount">{formatQuota(p)}</div>
                </div>

                <p class="card-intro">{p.intro_en || p.intro}</p>
              </div>

              <div class="card-footer">
                <div class="card-models-tag">
                  {p.free_models && p.free_models.length > 0 ? (
                    <span class="model-code">{p.free_models[0]}</span>
                  ) : (
                    <span>Standard</span>
                  )}
                  {p.free_models && p.free_models.length > 1 && (
                    <span class="model-count">+{p.free_models.length - 1}</span>
                  )}
                </div>
                <div class="card-verified-date">
                  Verified {formatVerified(p.last_verified)}
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- No results -->
      <div id="no-results" class="no-result-box" style="display: none;">
        <p>No matching platform or model found.</p>
        <button id="btn-reset-filters" class="btn-reset">Reset Filters</button>
      </div>
    </div>
  </section>

  <!-- 3. Quick Links Banner -->
  <section class="section-wrap">
    <div class="container">
      <div class="home-bottom-nav-grid">
        <a href="/en/guide/" class="home-sub-banner">
          <div class="sub-banner-badge">PRACTICE PLAYBOOK</div>
          <h3>📖 10s Code Generator & Playbook ↗</h3>
          <p>Native configuration generator for OpenClaw, Claude Code, Cursor, and multi-key pooling with 90% cost-saving hacks.</p>
        </a>
        <a href="/en/about/" class="home-sub-banner">
          <div class="sub-banner-badge">OUR MANIFESTO</div>
          <h3>🧭 Four Long-term Coordinates ↗</h3>
          <p>Building with free tokens while maintaining critical thinking. Explore our manifesto on codified reality and AI compute energy.</p>
        </a>
      </div>
    </div>
  </section>

  <style>
    /* Hero Editorial */
    .hero-editorial {
      padding: 44px 0 36px;
      border-bottom: 1px solid var(--card-border);
      background: #ffffff;
      position: relative;
    }
    .hero-editorial-inner {
      display: flex;
      gap: 40px;
      align-items: flex-start;
    }
    .hero-copy {
      flex: 1;
      min-width: 0;
    }
    .hero-mascot-wrapper {
      width: 320px;
      flex-shrink: 0;
    }
    @media (max-width: 900px) {
      .hero-editorial-inner {
        flex-direction: column;
      }
      .hero-mascot-wrapper {
        width: 100%;
      }
    }

    /* Top Search Box */
    .hero-search-wrap {
      margin-bottom: 20px;
    }
    .hero-search-input {
      width: 100%;
      background: var(--bg-subtle);
      border: 1.5px solid var(--card-border);
      border-radius: 8px;
      padding: 12px 18px;
      font-size: 14.5px;
      font-family: inherit;
      color: var(--text);
      outline: none;
      transition: all 0.15s ease;
    }
    .hero-search-input:focus {
      background: #ffffff;
      border-color: var(--text);
      box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }
    .hero-search-input::placeholder {
      color: var(--text-light);
    }

    /* Mode Switcher */
    .hero-track-switcher {
      display: inline-flex;
      position: relative;
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 3px;
      margin-bottom: 22px;
    }
    .track-tab {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      border: none;
      background: transparent;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
      z-index: 2;
    }
    .track-tab:hover {
      color: var(--text);
    }
    .track-tab.active {
      background: #ffffff;
      color: var(--text);
      box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }
    .track-num {
      font-family: var(--font-mono);
      font-size: 11px;
      opacity: 0.6;
    }
    .track-progress-bar {
      position: absolute;
      bottom: -4px;
      left: 3px;
      right: 3px;
      height: 2px;
      background: rgba(0,0,0,0.04);
      border-radius: 1px;
      overflow: hidden;
    }
    .track-progress-inner {
      width: 0%;
      height: 100%;
      background: var(--text);
      transition: width 0.1s linear;
    }

    /* Slides */
    .hero-slides-wrapper {
      position: relative;
    }
    .hero-slide {
      display: none;
      animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero-slide.active {
      display: block;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .hero-eyebrow {
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.8px;
      color: var(--text-light);
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .hero-eyebrow-lab {
      color: #2563eb;
    }
    .hero-headline {
      font-size: clamp(26px, 4vw, 36px);
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -0.6px;
      color: var(--text);
      margin-bottom: 12px;
    }
    .hero-lead {
      font-size: 14.5px;
      line-height: 1.65;
      color: var(--text-muted);
      max-width: 620px;
      margin-bottom: 18px;
    }

    /* Telemetry */
    .radar-telemetry-bar {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      padding: 6px 14px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .telemetry-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
    }
    .telemetry-pulse {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #10b981;
      display: inline-block;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    .telemetry-label {
      color: var(--text-light);
    }
    .telemetry-value {
      font-weight: 600;
      color: var(--text);
    }
    .telemetry-timer {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--accent);
      min-width: 44px;
    }
    .telemetry-divider {
      width: 1px;
      height: 12px;
      background: var(--card-border);
    }

    /* Key Links */
    .quick-index-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 22px;
      flex-wrap: wrap;
    }
    .quick-index-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: var(--text-light);
      text-transform: uppercase;
    }
    .quick-index-links {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .quick-link {
      font-size: 12px;
      font-weight: 500;
      color: var(--text);
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      padding: 3px 8px;
      border-radius: 4px;
      transition: all 0.15s;
    }
    .quick-link:hover {
      border-color: var(--text);
      background: #ffffff;
    }

    /* Lab Highlights */
    .lab-highlights-grid {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 22px;
      max-width: 620px;
    }
    .lab-highlight-item {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      padding: 8px 12px;
      font-size: 12.5px;
    }
    .lab-highlight-badge {
      font-size: 11px;
      font-weight: 700;
      color: #2563eb;
      background: rgba(37, 99, 235, 0.08);
      border: 1px solid rgba(37, 99, 235, 0.2);
      padding: 1px 6px;
      border-radius: 4px;
      flex-shrink: 0;
    }
    .lab-highlight-text {
      color: var(--text);
      font-weight: 500;
    }

    /* Buttons */
    .hero-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .btn-hero-primary {
      background: var(--text);
      color: #ffffff;
      font-size: 13.5px;
      font-weight: 600;
      padding: 9px 18px;
      border-radius: 6px;
      transition: opacity 0.15s ease;
      display: inline-flex;
      align-items: center;
    }
    .btn-hero-primary:hover {
      opacity: 0.9;
    }
    .btn-hero-lab {
      background: #2563eb;
    }
    .btn-hero-lab:hover {
      background: #1d4ed8;
    }
    .btn-hero-secondary {
      background: transparent;
      border: 1px solid var(--card-border);
      color: var(--text);
      font-size: 13.5px;
      font-weight: 600;
      padding: 9px 16px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
    }
    .btn-hero-secondary:hover {
      border-color: var(--text);
      background: #ffffff;
    }

    /* Right Mascot Card */
    .hero-card-mascot {
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }
    .hero-mascot-img {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }
    .mascot-caption {
      padding: 12px 14px;
      font-size: 12px;
      color: var(--text-muted);
      border-top: 1px solid var(--card-border);
      background: #ffffff;
      text-align: center;
    }

    /* Section & Grid */
    .section-wrap {
      padding: 44px 0;
    }
    .section-bg {
      background: var(--bg-subtle);
      border-top: 1px solid var(--card-border);
      border-bottom: 1px solid var(--card-border);
    }
    .section-head {
      margin-bottom: 24px;
    }
    .section-eyebrow {
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.8px;
      color: var(--text-light);
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .section-title {
      font-size: 24px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.4px;
    }

    /* Filter Pills */
    .filter-pills {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }
    .filter-pill {
      background: #ffffff;
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      font-size: 12.5px;
      font-weight: 500;
      padding: 5px 12px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .filter-pill:hover {
      border-color: var(--text);
      color: var(--text);
    }
    .filter-pill.active {
      background: var(--text);
      color: #ffffff;
      border-color: var(--text);
      font-weight: 600;
    }

    /* Grid */
    .editorial-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    @media (max-width: 960px) {
      .editorial-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 600px) {
      .editorial-grid {
        grid-template-columns: 1fr;
      }
    }

    .editorial-card {
      background: #ffffff;
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
      cursor: pointer;
      min-height: 220px;
    }
    .editorial-card:hover {
      transform: translateY(-2px);
      border-color: var(--text);
      box-shadow: 0 6px 20px rgba(0,0,0,0.04);
    }
    .card-meta-top {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }
    .card-category {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-light);
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    .badge-tag {
      font-size: 10.5px;
      font-weight: 700;
      padding: 1.5px 6px;
      border-radius: 4px;
      display: inline-flex;
      align-items: center;
    }
    .badge-limited {
      background: #fef2f2;
      color: #dc2626;
      border: 1px solid #fee2e2;
    }
    .badge-permanent {
      background: #f0fdf4;
      color: #16a34a;
      border: 1px solid #dcfce7;
    }
    .badge-daily {
      background: #eff6ff;
      color: #2563eb;
      border: 1px solid #dbeafe;
    }
    .badge-domestic {
      background: #f0fdfa;
      color: #0d9488;
      border: 1px solid #ccfbf1;
