---
import Base from '../../../layouts/Base.astro';
import ArticleReader from '../../../components/ArticleReader.astro';
import articles from '../../../data/articles.json';

export async function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const relatedArticles = articles.filter((a) => a.slug !== article.slug).slice(0, 2);
---

<Base
  title={`${article.title_en || article.title} · FreeToken Playbook`}
  description={article.summary_en || article.summary}
  lang="en"
>
  <ArticleReader article={article} relatedArticles={relatedArticles} lang="en" />
</Base>
