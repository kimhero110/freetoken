---
import Base from '../../../layouts/Base.astro';
import articles from '../../../data/articles.json';
---

<Base
  title="In-Depth Technical Articles & Playbooks · FreeToken Intelligence"
  description="Curated long-form guides on LLM compute economics, OpenClaw agent cost reduction, multi-key gateways, and 5-hour rolling windows."
  lang="en"
>
  <section class="articles-hero-section">
    <div class="container">
      <div class="articles-hero-badge">ARTICLE HUB · TECHNICAL INTELLIGENCE</div>
      <h1 class="articles-hero-title">AI Compute Architecture & Autonomous Agent Playbooks</h1>
      <p class="articles-hero-desc">
        From standard protocols to production battle-tested optimization: Deep architectural playbooks on cutting OpenClaw token burns by 90%, 450M token economics, and rolling window limits.
      </p>

      <div class="articles-meta-bar">
        <span>{articles.length} In-Depth Articles</span>
        <span class="meta-dot">·</span>
        <span>Continuously Updated</span>
        <span class="meta-dot">·</span>
        <a href="https://github.com/kimhero110/freetoken/tree/main/content/articles" target="_blank" rel="noopener" class="article-gh-link">Contribute on GitHub ↗</a>
      </div>
    </div>
  </section>

  <section class="section-wrap section-bg">
    <div class="container">
      <div class="articles-grid">
        {articles.map((art) => (
          <article class="article-listing-card">
            <div class="art-card-top">
              <span class="art-category-badge">{art.category}</span>
              <span class="art-read-time">{art.reading_time}</span>
            </div>

            <h2 class="art-card-title">
              <a href={`/en/article/${art.slug}/`}>{art.title_en || art.title}</a>
            </h2>

            <p class="art-card-summary">{art.summary_en || art.summary}</p>

            <div class="art-tags-list">
              {art.tags.map((tag: string) => (
                <span class="art-tag">#{tag}</span>
              ))}
            </div>

            <div class="art-card-footer">
              <div class="art-author-date">
                <span class="art-author">{art.author}</span>
                <span class="art-date">Published on {art.date}</span>
              </div>
              <a href={`/en/article/${art.slug}/`} class="art-read-btn">Read Article →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <style>
    .articles-hero-section {
      padding: 56px 0 28px;
      border-bottom: 1px solid var(--card-border);
      background: #ffffff;
    }
    .articles-hero-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.6px;
      color: var(--accent);
      background: rgba(37, 99, 235, 0.08);
      border: 1px solid rgba(37, 99, 235, 0.2);
      padding: 3px 10px;
      border-radius: 4px;
      margin-bottom: 14px;
    }
    .articles-hero-title {
      font-size: clamp(24px, 4vw, 36px);
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.6px;
      margin-bottom: 14px;
      line-height: 1.25;
    }
    .articles-hero-desc {
      font-size: 15px;
      color: var(--text-muted);
      max-width: 820px;
      line-height: 1.7;
      margin-bottom: 18px;
    }
    .articles-meta-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--text-light);
    }
    .meta-dot {
      opacity: 0.5;
    }
    .article-gh-link {
      color: var(--text);
      font-weight: 600;
      text-decoration: underline;
    }

    .section-wrap {
      padding: 44px 0;
    }
    .section-bg {
      background: var(--bg-subtle);
      border-top: 1px solid var(--card-border);
      border-bottom: 1px solid var(--card-border);
    }

    .articles-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    @media (max-width: 768px) {
      .articles-grid {
        grid-template-columns: 1fr;
      }
    }

    .article-listing-card {
      background: #ffffff;
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.2s ease;
      box-shadow: 0 4px 16px rgba(0,0,0,0.02);
    }
    .article-listing-card:hover {
      transform: translateY(-2px);
      border-color: var(--text);
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    }

    .art-card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }
    .art-category-badge {
      font-size: 11px;
      font-weight: 700;
      color: var(--accent);
      background: rgba(37, 99, 235, 0.08);
      border: 1px solid rgba(37, 99, 235, 0.2);
      padding: 2px 8px;
      border-radius: 4px;
    }
    .art-read-time {
      font-size: 12px;
      color: var(--text-light);
    }

    .art-card-title {
      font-size: 19px;
      font-weight: 800;
      line-height: 1.4;
      margin-bottom: 12px;
    }
    .art-card-title a {
      color: var(--text);
      transition: color 0.15s;
    }
    .art-card-title a:hover {
      color: var(--accent);
    }

    .art-card-summary {
      font-size: 13.5px;
      color: var(--text-muted);
      line-height: 1.65;
      margin-bottom: 16px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .art-tags-list {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }
    .art-tag {
      font-size: 11.5px;
      font-weight: 500;
      color: var(--text-light);
      background: var(--bg-subtle);
      padding: 2px 6px;
      border-radius: 4px;
    }

    .art-card-footer {
      border-top: 1px solid var(--card-border);
      padding-top: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .art-author-date {
      display: flex;
      flex-direction: column;
      font-size: 11.5px;
    }
    .art-author {
      font-weight: 700;
      color: var(--text);
    }
    .art-date {
      color: var(--text-light);
    }
    .art-read-btn {
      font-size: 13px;
      font-weight: 700;
      color: var(--accent);
      transition: transform 0.15s;
    }
    .art-read-btn:hover {
      transform: translateX(3px);
    }
  </style>
</Base>
