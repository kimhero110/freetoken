---
// 平台详情页：展示单个平台的免费额度、条件与相关链接
import Base from '../../layouts/Base.astro';
import platforms from '../../data/platforms.json';

export function getStaticPaths() {
  return platforms.map((p: any) => ({
    params: { slug: p.slug },
    props: { platform: p },
  }));
}

const { platform: p } = Astro.props;
const statusText: Record<string, string> = {
  active: '有效',
  expired: '已过期',
  unverified: '待核实',
};
const q = p.free_quota ?? {};
---
<Base title={`${p.name} 免费额度`} description={p.intro}>
  <div class="detail-section">
    <h1 style="font-size:20px;margin-bottom:8px;">{p.name} <small style="color:var(--muted);">{p.name_en}</small></h1>
    <div>
      <span class={`badge ${p.status}`}>{statusText[p.status] ?? p.status}</span>
      <span class="badge type">{q.type ?? '未知'}</span>
      <span class="badge type">{p.category === 'llm-api' ? 'LLM API' : '云平台'}</span>
    </div>
    <p class="quota" style="font-size:20px;margin-top:12px;">
      {q.amount != null ? `${q.amount} ${q.unit ?? ''}` : '暂无明确免费额度信息'}
    </p>
    <p class="intro">{p.intro}</p>
    <p class="meta">最后人工核实：{p.last_verified}</p>
    {p.last_checked && <p class="meta">最后自动检查：{p.last_checked}</p>}
  </div>

  {q.conditions && q.conditions.length > 0 && (
    <div class="detail-section">
      <h2>免费额度使用条件</h2>
      <ul>
        {q.conditions.map((c: string) => <li>{c}</li>)}
      </ul>
    </div>
  )}

  <div class="detail-section">
    <h2>相关链接</h2>
    <ul>
      <li>官方网站：<a href={p.website} rel="nofollow noopener" target="_blank">{p.website}</a></li>
      {p.register_url && <li>注册入口：<a href={p.register_url} rel="nofollow noopener" target="_blank">{p.register_url}</a></li>}
      {p.docs_url && <li>官方文档：<a href={p.docs_url} rel="nofollow noopener" target="_blank">{p.docs_url}</a></li>}
    </ul>
  </div>

  <div class="detail-section">
    <h2>标签</h2>
    <p>{(p.tags ?? []).map((t: string) => <span class="badge type">{t}</span>)}</p>
  </div>
</Base>
