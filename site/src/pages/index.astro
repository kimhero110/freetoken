---
// FreeTokens.info 极简主义科技杂志风格主页 (40+ 平台完整标签与实时巡检雷达)
import Base from '../layouts/Base.astro';
import platforms from '../data/platforms.json';

function formatQuota(p: any): string {
  const q = p.free_quota;
  if (!q || q.amount == null) return '无明确赠送额度';
  return `${q.amount} ${q.unit ?? ''}`.trim();
}

function formatVerified(dateStr: any): string {
  return dateStr || '2026-09-02';
}

const totalCount = platforms.length;
---
<Base>
  <!-- 1. Hero 区域 (双轨轮播: 01 探索者免费算力雷达 | 02 职业开发者算力实验室) -->
  <section class="hero-editorial" id="hero-editorial">
    <div class="container hero-editorial-inner">
      <div class="hero-copy">
        
        <!-- 搜索框：置顶在第一交互位 -->
        <div class="hero-search-wrap">
          <input
            type="text"
            id="search-input"
            class="hero-search-input"
            placeholder="搜索 40+ 家平台、模型（如 Grok, Gemini, GLM-4, StepFun, DeepSeek）或特性..."
            autocomplete="off"
          />
        </div>

        <!-- 双轨模式切换器 (Segmented Switcher) -->
        <div class="hero-track-switcher">
          <button class="track-tab active" data-slide="0" id="tab-slide-0">
            <span class="track-num">01</span>
            <span>免费算力雷达</span>
          </button>
          <button class="track-tab" data-slide="1" id="tab-slide-1">
            <span class="track-num">02</span>
            <span>职业开发者 Lab ↗</span>
          </button>
          <div class="track-progress-bar">
            <div class="track-progress-inner" id="track-progress-inner"></div>
          </div>
        </div>

        <!-- 轮播幻灯片容器 -->
        <div class="hero-slides-wrapper">
          
          <!-- Slide 0: 免费算力雷达 (公益/思维/免费Token) -->
          <div class="hero-slide active" id="hero-slide-0">
            <p class="hero-eyebrow">一人公司 · AI 算力与开源情报</p>
            <h1 class="hero-headline">
              用免费 Token 做工具，<br/>
              也提醒自己保持思考。
            </h1>
            <p class="hero-lead">
              持续追踪全球主流大模型与云平台免费 API 配额，提供透明规则与 10 秒接入代码。
            </p>

            <!-- 极简中性仪表条 (动态巡检与探测脉冲) -->
            <div class="radar-telemetry-bar">
              <div class="telemetry-item">
                <span class="telemetry-pulse"></span>
                <span class="telemetry-label">状态</span>
                <span class="telemetry-value">{totalCount}/{totalCount} 节点在线</span>
              </div>
              <div class="telemetry-divider"></div>
              <div class="telemetry-item">
                <span class="telemetry-label">全网核验</span>
                <span id="telemetry-last-sweep" class="telemetry-value">实时同步</span>
              </div>
              <div class="telemetry-divider"></div>
              <div class="telemetry-item">
                <span class="telemetry-label">额度巡检</span>
                <span id="radar-live-countdown" class="telemetry-timer">00:59</span>
              </div>
              <div class="telemetry-divider"></div>
              <div class="telemetry-item">
                <span class="telemetry-label">新源雷达</span>
                <span id="radar-discover-countdown" class="telemetry-timer">04:59</span>
              </div>
            </div>

            <!-- 重点索引 -->
            <div class="quick-index-bar">
              <span class="quick-index-label">重点索引</span>
              <div class="quick-index-links">
                <a href="/platform/xai-grok/" class="quick-link">xAI Grok · 150$/月</a>
                <a href="/platform/google-ai-studio/" class="quick-link">Gemini · 1500次/天</a>
                <a href="/platform/volcengine/" class="quick-link">火山方舟 · 200万/天</a>
                <a href="/platform/stepfun/" class="quick-link">阶跃星辰 · 15元</a>
                <a href="/platform/siliconflow/" class="quick-link">硅基流动 · 2000万</a>
              </div>
            </div>

            <div class="hero-actions">
              <a class="btn-hero-primary" href="#products">浏览全部 40+ 平台 ↓</a>
              <a class="btn-hero-secondary" href="/guide/">📖 接入实战手册 ↗</a>
              <button class="btn-hero-secondary open-wechat-trigger">关注公众号 ↗</button>
            </div>
          </div>

          <!-- Slide 1: 职业开发者实验室 (商业化/高可靠/freetokenlab.com) -->
          <div class="hero-slide" id="hero-slide-1">
            <p class="hero-eyebrow hero-eyebrow-lab">重度生产力 · 商业级高可用算力方案</p>
            <h1 class="hero-headline">
              我是职业开发者，<br/>
              我需要极具性价比的可靠 Token。
            </h1>
            <p class="hero-lead">
              面向严肃商业交付与自动化工程：提供国内可用、基于美国原生 Remote App 服务器的 Claude 3.5 Sonnet / Codex 极稳接入，以及国内主流大模型开发者专属采购折扣。
            </p>

            <!-- 商业级核心特性标签 -->
            <div class="lab-highlights-grid">
              <div class="lab-highlight-item">
                <span class="lab-highlight-badge">原生稳定</span>
                <span class="lab-highlight-text">Claude 3.5 Sonnet / Opus 美国原生防封直连通道</span>
              </div>
              <div class="lab-highlight-item">
                <span class="lab-highlight-badge">编程代理</span>
                <span class="lab-highlight-text">Codex & Cursor 生产级编程工具全天候低延迟</span>
              </div>
              <div class="lab-highlight-item">
                <span class="lab-highlight-badge">专属折扣</span>
                <span class="lab-highlight-text">国内主流大模型企业级底价采购与高并发池化</span>
              </div>
            </div>

            <div class="hero-actions">
              <a class="btn-hero-primary btn-hero-lab" href="https://freetokenlab.com" target="_blank" rel="noopener">
                前往 FreeToken Lab 探索职业算力 ↗
              </a>
              <a class="btn-hero-secondary" href="/guide/">查看接入架构 ↗</a>
            </div>
          </div>

        </div>
      </div>

      <!-- 右侧吉祥物卡片 -->
      <div class="hero-mascot-wrapper">
        <div class="hero-card-mascot">
          <img src="/images/hero-mascot.webp" alt="思考的科技猫头鹰插画" class="hero-mascot-img" width="380" height="380" />
          <div class="mascot-caption">
            <p>工具让人走得更快，思考决定往哪里走。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 平台资源库 (40+ 平台完整网格与多维标签) -->
  <section class="section-wrap section-bg" id="products">
    <div class="container">
      <header class="section-head">
        <p class="section-eyebrow">资源雷达</p>
        <h2 class="section-title">全网免费 API Token 配额清单 (40+ 平台已核验)</h2>
      </header>

      <!-- 分类过滤 Tab -->
      <div class="filter-pills" id="filter-tabs">
        <button class="filter-pill active" data-filter="all">全部平台 ({totalCount})</button>
        <button class="filter-pill" data-filter="limited">限时活动</button>
        <button class="filter-pill" data-filter="permanent">大厂基座</button>
        <button class="filter-pill" data-filter="daily">每日刷新</button>
        <button class="filter-pill" data-filter="domestic">国产直连</button>
        <button class="filter-pill" data-filter="tools">开发与搜索</button>
        <button class="filter-pill" data-filter="multimodal">多模态生图</button>
        <button class="filter-pill" data-filter="web3">测试网络</button>
      </div>

      <!-- 资源卡片网格 -->
      <div class="editorial-grid" id="platform-grid">
        {platforms.map((p) => {
          const q = p.free_quota ?? {};
          const qType = String(q.type || '');
          const qReset = String(q.reset_period || '');
          const tags = Array.isArray(p.tags) ? p.tags : [];
          const tagsStr = tags.join(' ');

          // 多维精准标签识别
          const isLimited = tags.includes('限时') || tags.includes('体验金') || qType.includes('限时') || qType.includes('体验') || qType.includes('赠送') || qType.includes('优惠') || qType.includes('补贴');
          const isPermanent = tags.includes('永久') || tags.includes('免费层') || qType.includes('永久') || qType.includes('完全') || qType.includes('免费层');
          const isDaily = tags.includes('每日') || tags.includes('每月') || qType.includes('每日') || qType.includes('每小时') || qType.includes('每月') || qReset.includes('日') || qReset.includes('小时') || qReset.includes('月');
          const isDomestic = p.category === '国内主流' || p.category === '大厂云服务' || tags.includes('国产直连') || tags.includes('国内直连');
          const isTools = p.category === '搜索与工具' || p.slug === 'tavily' || p.slug === 'jina-ai';
          const isMultimodal = p.category === '多模态/工具' || p.category === '多模态' || p.slug === 'pollinations';
          const isWeb3 = p.category === '区块链水龙头' || p.slug === 'sepolia-faucet';

          return (
            <a
              class="editorial-card"
              href={`/platform/${p.slug}/`}
              data-limited={isLimited ? "true" : "false"}
              data-permanent={isPermanent ? "true" : "false"}
              data-daily={isDaily ? "true" : "false"}
              data-domestic={isDomestic ? "true" : "false"}
              data-tools={isTools ? "true" : "false"}
              data-multimodal={isMultimodal ? "true" : "false"}
              data-web3={isWeb3 ? "true" : "false"}
              data-search={`${p.name} ${p.name_en ?? ''} ${p.slug} ${p.intro ?? ''} ${tagsStr}`.toLowerCase()}
            >
              <div class="card-main-content">
                <div class="card-meta-top">
                  <span class="card-category">{p.category}</span>
                  {isLimited && <span class="badge-tag badge-limited">限时</span>}
                  {isDaily && <span class="badge-tag badge-daily">每日</span>}
                  {isPermanent && <span class="badge-tag badge-permanent">永久</span>}
                  {isDomestic && <span class="badge-tag badge-domestic">国产</span>}
                </div>

                <h3 class="card-title">
                  {p.name}
                  {p.name_en && p.name !== p.name_en && <small class="card-name-en">{p.name_en}</small>}
                </h3>

                <div class="card-quota-box">
                  <div class="quota-label">核心免费额度</div>
                  <div class="quota-amount">{formatQuota(p)}</div>
                </div>

                <p class="card-intro">{p.intro}</p>
              </div>

              <div class="card-footer">
                <div class="card-models-tag">
                  {p.free_models && p.free_models.length > 0 ? (
                    <span class="model-code">{p.free_models[0]}</span>
                  ) : (
                    <span>标准模型</span>
                  )}
                  {p.free_models && p.free_models.length > 1 && (
                    <span class="model-count">+{p.free_models.length - 1}</span>
                  )}
                </div>
                <div class="card-verified-date">
                  核验 {formatVerified(p.last_verified)}
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <!-- 无搜索结果提示 -->
      <div id="no-results" class="no-result-box" style="display: none;">
        <p>未找到符合条件的平台或模型</p>
        <button id="btn-reset-filters" class="btn-reset">重置筛选条件</button>
      </div>
    </div>
  </section>

  <!-- 3. 极简实战指南与哲学入口 Banner (引导至 /guide/ 与 /about/) -->
  <section class="section-wrap">
    <div class="container">
      <div class="home-bottom-nav-grid">
        <a href="/guide/" class="home-sub-banner">
          <div class="sub-banner-badge">PRACTICE PLAYBOOK</div>
          <h3>📖 10秒代码生成器与实战指南 ↗</h3>
          <p>原生适配 OpenClaw、Claude Code、Cursor 与多 Key 聚合池。内置 5 小时滑动窗口避坑与降本 90% 极客技巧。</p>
        </a>
        <a href="/about/" class="home-sub-banner">
          <div class="sub-banner-badge">OUR MANIFESTO</div>
          <h3>🧭 四个长期坐标与极客宣言 ↗</h3>
          <p>用免费 Token 做工具，也提醒自己保持思考。探索 AI 引导未来、Token 能源化与世界代码化的长期思考。</p>
        </a>
      </div>
    </div>
  </section>

  <style>
    /* Hero Editorial 双轨轮播样式 */
    .hero-editorial {
      padding: 44px 0 36px;
      border-bottom: 1px solid var(--card-border);
      background: #ffffff;
      position: relative;
    }
    .hero-editorial-inner {
      display: flex;
      gap: 40px;
      align-items: flex-start;
    }
    .hero-copy {
      flex: 1;
      min-width: 0;
    }
    .hero-mascot-wrapper {
      width: 320px;
      flex-shrink: 0;
    }
    @media (max-width: 900px) {
      .hero-editorial-inner {
        flex-direction: column;
      }
      .hero-mascot-wrapper {
        width: 100%;
      }
    }

    /* 置顶搜索框 */
    .hero-search-wrap {
      margin-bottom: 20px;
    }
    .hero-search-input {
      width: 100%;
      background: var(--bg-subtle);
      border: 1.5px solid var(--card-border);
      border-radius: 8px;
      padding: 12px 18px;
      font-size: 14.5px;
      font-family: inherit;
      color: var(--text);
      outline: none;
      transition: all 0.15s ease;
    }
    .hero-search-input:focus {
      background: #ffffff;
      border-color: var(--text);
      box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }
    .hero-search-input::placeholder {
      color: var(--text-light);
    }

    /* 模式切换器 */
    .hero-track-switcher {
      display: inline-flex;
      position: relative;
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 3px;
      margin-bottom: 22px;
    }
    .track-tab {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      border: none;
      background: transparent;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
      z-index: 2;
    }
    .track-tab:hover {
      color: var(--text);
    }
    .track-tab.active {
      background: #ffffff;
      color: var(--text);
      box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    }
    .track-num {
      font-family: var(--font-mono);
      font-size: 11px;
      opacity: 0.6;
    }
    .track-progress-bar {
      position: absolute;
      bottom: -4px;
      left: 3px;
      right: 3px;
      height: 2px;
      background: rgba(0,0,0,0.04);
      border-radius: 1px;
      overflow: hidden;
    }
    .track-progress-inner {
      width: 0%;
      height: 100%;
      background: var(--text);
      transition: width 0.1s linear;
    }

    /* 轮播幻灯片 */
    .hero-slides-wrapper {
      position: relative;
    }
    .hero-slide {
      display: none;
      animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero-slide.active {
      display: block;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .hero-eyebrow {
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.8px;
      color: var(--text-light);
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .hero-eyebrow-lab {
      color: #2563eb;
    }
    .hero-headline {
      font-size: clamp(26px, 4vw, 36px);
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -0.6px;
      color: var(--text);
      margin-bottom: 12px;
    }
    .hero-lead {
      font-size: 14.5px;
      line-height: 1.65;
      color: var(--text-muted);
      max-width: 620px;
      margin-bottom: 18px;
    }

    /* 仪表盘 */
    .radar-telemetry-bar {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      padding: 6px 14px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .telemetry-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
    }
    .telemetry-pulse {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #10b981;
      display: inline-block;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    .telemetry-label {
      color: var(--text-light);
    }
    .telemetry-value {
      font-weight: 600;
      color: var(--text);
    }
    .telemetry-timer {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--accent);
      min-width: 44px;
    }
    .telemetry-divider {
      width: 1px;
      height: 12px;
      background: var(--card-border);
    }

    /* 重点索引 */
    .quick-index-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 22px;
      flex-wrap: wrap;
    }
    .quick-index-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: var(--text-light);
      text-transform: uppercase;
    }
    .quick-index-links {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .quick-link {
      font-size: 12px;
      font-weight: 500;
      color: var(--text);
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      padding: 3px 8px;
      border-radius: 4px;
      transition: all 0.15s;
    }
    .quick-link:hover {
      border-color: var(--text);
      background: #ffffff;
    }

    /* 商业版标签网格 */
    .lab-highlights-grid {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 22px;
      max-width: 620px;
    }
    .lab-highlight-item {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      padding: 8px 12px;
      font-size: 12.5px;
    }
    .lab-highlight-badge {
      font-size: 11px;
      font-weight: 700;
      color: #2563eb;
      background: rgba(37, 99, 235, 0.08);
      border: 1px solid rgba(37, 99, 235, 0.2);
      padding: 1px 6px;
      border-radius: 4px;
      flex-shrink: 0;
    }
    .lab-highlight-text {
      color: var(--text);
      font-weight: 500;
    }

    /* 按钮组 */
    .hero-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .btn-hero-primary {
      background: var(--text);
      color: #ffffff;
      font-size: 13.5px;
      font-weight: 600;
      padding: 9px 18px;
      border-radius: 6px;
      transition: opacity 0.15s ease;
      display: inline-flex;
      align-items: center;
    }
    .btn-hero-primary:hover {
      opacity: 0.9;
    }
    .btn-hero-lab {
      background: #2563eb;
    }
    .btn-hero-lab:hover {
      background: #1d4ed8;
    }
    .btn-hero-secondary {
      background: transparent;
      border: 1px solid var(--card-border);
      color: var(--text);
      font-size: 13.5px;
      font-weight: 600;
      padding: 9px 16px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
    }
    .btn-hero-secondary:hover {
      border-color: var(--text);
      background: #ffffff;
    }

    /* 右侧插画卡片 */
    .hero-card-mascot {
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    }
    .hero-mascot-img {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }
    .mascot-caption {
      padding: 12px 14px;
      font-size: 12px;
      color: var(--text-muted);
      border-top: 1px solid var(--card-border);
      background: #ffffff;
      text-align: center;
    }

    /* 平台网格与板块 */
    .section-wrap {
      padding: 44px 0;
    }
    .section-bg {
      background: var(--bg-subtle);
      border-top: 1px solid var(--card-border);
      border-bottom: 1px solid var(--card-border);
    }
    .section-head {
      margin-bottom: 24px;
    }
    .section-eyebrow {
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.8px;
      color: var(--text-light);
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .section-title {
      font-size: 24px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.4px;
    }

    /* 过滤 Pill */
    .filter-pills {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }
    .filter-pill {
      background: #ffffff;
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      font-size: 12.5px;
      font-weight: 500;
      padding: 5px 12px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .filter-pill:hover {
      border-color: var(--text);
      color: var(--text);
    }
    .filter-pill.active {
      background: var(--text);
      color: #ffffff;
      border-color: var(--text);
      font-weight: 600;
    }

    /* 网格布局 */
    .editorial-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    @media (max-width: 960px) {
      .editorial-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 600px) {
      .editorial-grid {
        grid-template-columns: 1fr;
      }
    }

    .editorial-card {
      background: #ffffff;
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
      cursor: pointer;
      min-height: 220px;
    }
    .editorial-card:hover {
      transform: translateY(-2px);
      border-color: var(--text);
      box-shadow: 0 6px 20px rgba(0,0,0,0.04);
    }
    .card-meta-top {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }
    .card-category {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-light);
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    .badge-tag {
      font-size: 10.5px;
      font-weight: 700;
      padding: 1.5px 6px;
      border-radius: 4px;
      display: inline-flex;
      align-items: center;
    }
    .badge-limited {
      background: #fef2f2;
      color: #dc2626;
      border: 1px solid #fee2e2;
    }
    .badge-permanent {
      background: #f0fdf4;
      color: #16a34a;
      border: 1px solid #dcfce7;
    }
    .badge-daily {
      background: #eff6ff;
      color: #2563eb;
      border: 1px solid #dbeafe;
    }
    .badge-domestic {
      background: #f0fdfa;
      color: #0d9488;
      border: 1px solid #ccfbf1;
    }

    .card-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 10px;
      display: flex;
      align-items: baseline;
      gap: 6px;
      flex-wrap: wrap;
    }
    .card-name-en {
      font-size: 11.5px;
      font-weight: 400;
      color: var(--text-light);
    }

    .card-quota-box {
      background: var(--bg-subtle);
      border-radius: 6px;
      padding: 8px 10px;
      margin-bottom: 12px;
    }
    .quota-label {
      font-size: 10.5px;
      color: var(--text-light);
      margin-bottom: 2px;
    }
    .quota-amount {
      font-family: var(--font-mono);
      font-size: 13.5px;
      font-weight: 700;
      color: var(--accent);
    }

    .card-intro {
      font-size: 12.5px;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 14px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .card-footer {
      border-top: 1px solid var(--card-border);
      padding-top: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
    }
    .card-models-tag {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .model-code {
      font-family: var(--font-mono);
      color: var(--text-muted);
      background: var(--bg-subtle);
      padding: 1px 5px;
      border-radius: 3px;
      max-width: 120px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .model-count {
      color: var(--text-light);
      font-weight: 600;
    }
    .card-verified-date {
      color: var(--text-light);
    }

    /* Home Sub Banners */
    .home-bottom-nav-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    @media (max-width: 768px) {
      .home-bottom-nav-grid { grid-template-columns: 1fr; }
    }
    .home-sub-banner {
      background: #ffffff;
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 24px 22px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.02);
      transition: all 0.2s ease;
      display: flex;
      flex-direction: column;
    }
    .home-sub-banner:hover {
      border-color: var(--text);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    }
    .sub-banner-badge {
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.6px;
      color: var(--accent);
      margin-bottom: 6px;
    }
    .home-sub-banner h3 {
      font-size: 16.5px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 6px;
    }
    .home-sub-banner p {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .no-result-box {
      text-align: center;
      padding: 48px 0;
      color: var(--text-muted);
    }
    .btn-reset {
      margin-top: 12px;
      background: var(--text);
      color: #ffffff;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 13px;
      cursor: pointer;
    }
  </style>

  <script is:inline>
    // 1. 双轨轮播逻辑
    let currentSlide = 0;
    const slides = [
      document.getElementById('hero-slide-0'),
      document.getElementById('hero-slide-1')
    ];
    const tabs = [
      document.getElementById('tab-slide-0'),
      document.getElementById('tab-slide-1')
    ];
    const progressInner = document.getElementById('track-progress-inner');
    const heroSection = document.getElementById('hero-editorial');

    let autoSlideInterval = null;
    const SLIDE_DURATION = 12000;

    function showSlide(index) {
      slides.forEach((s, idx) => {
        if (s) s.classList.toggle('active', idx === index);
      });
      tabs.forEach((t, idx) => {
        if (t) t.classList.toggle('active', idx === index);
      });
      currentSlide = index;
      resetProgress();
    }

    function resetProgress() {
      if (progressInner) {
        progressInner.style.transition = 'none';
        progressInner.style.width = '0%';
        setTimeout(() => {
          if (progressInner) {
            progressInner.style.transition = `width ${SLIDE_DURATION}ms linear`;
            progressInner.style.width = '100%';
          }
        }, 30);
      }
    }

    tabs.forEach((tab, idx) => {
      tab?.addEventListener('click', () => {
        showSlide(idx);
        startAutoSlide();
      });
    });

    function startAutoSlide() {
      if (autoSlideInterval) clearInterval(autoSlideInterval);
      resetProgress();
      autoSlideInterval = setInterval(() => {
        const next = (currentSlide + 1) % 2;
        showSlide(next);
      }, SLIDE_DURATION);
    }

    function stopAutoSlide() {
      if (autoSlideInterval) {
        clearInterval(autoSlideInterval);
        autoSlideInterval = null;
      }
      if (progressInner) {
        progressInner.style.transition = 'none';
        progressInner.style.width = '0%';
      }
    }

    heroSection?.addEventListener('mouseenter', stopAutoSlide);
    heroSection?.addEventListener('mouseleave', startAutoSlide);
    startAutoSlide();

    // 2. 实时巡检与动态探测倒计时
    function updateCountdowns() {
      const now = new Date();
      const sec = now.getSeconds();
      const min = now.getMinutes();
      const hour = now.getHours();

      // 动态显示最近核验时间（如 今日 11:50）
      const lastMinSlot = Math.floor(min / 5) * 5;
      const lastSweepStr = `今日 ${String(hour).padStart(2, '0')}:${String(lastMinSlot).padStart(2, '0')}`;
      const lastSweepEl = document.getElementById('telemetry-last-sweep');
      if (lastSweepEl) lastSweepEl.textContent = lastSweepStr;

      // 额度巡检倒计时 (60秒循环)
      const quotaRemain = 60 - sec;
      const qEl = document.getElementById('radar-live-countdown');
      if (qEl) {
        if (quotaRemain <= 2) {
          qEl.textContent = '⚡ 巡检中';
          qEl.style.color = '#10b981';
        } else {
          qEl.textContent = `00:${String(quotaRemain).padStart(2, '0')}`;
          qEl.style.color = '';
        }
      }

      // 新源雷达倒计时 (5分钟循环: 300秒)
      const discoverRemain = 300 - ((min % 5) * 60 + sec);
      const dEl = document.getElementById('radar-discover-countdown');
      if (dEl) {
        if (discoverRemain <= 3) {
          dEl.textContent = '🔍 探测中';
          dEl.style.color = '#10b981';
        } else {
          const dm = Math.floor(discoverRemain / 60);
          const ds = discoverRemain % 60;
          dEl.textContent = `${String(dm).padStart(2, '0')}:${String(ds).padStart(2, '0')}`;
          dEl.style.color = '';
        }
      }
    }
    setInterval(updateCountdowns, 1000);
    updateCountdowns();

    // 3. 实时搜索与多维分类过滤
    const searchInput = document.getElementById('search-input');
    const filterTabs = document.querySelectorAll('#filter-tabs .filter-pill');
    const cards = document.querySelectorAll('#platform-grid .editorial-card');
    const noResultBox = document.getElementById('no-results');
    const btnReset = document.getElementById('btn-reset-filters');

    let activeFilter = 'all';
    let searchQuery = '';

    function filterCards() {
      let visibleCount = 0;
      cards.forEach(card => {
        const searchData = card.getAttribute('data-search') || '';
        const matchSearch = !searchQuery || searchData.includes(searchQuery);

        let matchFilter = true;
        if (activeFilter === 'limited') matchFilter = card.getAttribute('data-limited') === 'true';
        else if (activeFilter === 'permanent') matchFilter = card.getAttribute('data-permanent') === 'true';
        else if (activeFilter === 'daily') matchFilter = card.getAttribute('data-daily') === 'true';
        else if (activeFilter === 'domestic') matchFilter = card.getAttribute('data-domestic') === 'true';
        else if (activeFilter === 'tools') matchFilter = card.getAttribute('data-tools') === 'true';
        else if (activeFilter === 'multimodal') matchFilter = card.getAttribute('data-multimodal') === 'true';
        else if (activeFilter === 'web3') matchFilter = card.getAttribute('data-web3') === 'true';

        if (matchSearch && matchFilter) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResultBox) {
        noResultBox.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim().toLowerCase();
      filterCards();
    });

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        filterTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        activeFilter = tab.getAttribute('data-filter') || 'all';
        filterCards();
      });
    });

    btnReset?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      activeFilter = 'all';
      filterTabs.forEach((t, idx) => t.classList.toggle('active', idx === 0));
      filterCards();
    });

    // 4. 公众号弹窗绑定
    document.querySelectorAll('.open-wechat-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('btn-open-wechat')?.click();
      });
    });
  </script>
</Base>
