---
// FreeTokens.info 极简主义科技杂志风格主页 (支持双轨轮播)
import Base from '../layouts/Base.astro';
import platforms from '../data/platforms.json';

function formatQuota(p: any): string {
  const q = p.free_quota;
  if (!q || q.amount == null) return '无明确赠送额度';
  return `${q.amount} ${q.unit ?? ''}`.trim();
}

function formatVerified(dateStr: any): string {
  return dateStr || '2026-09-02';
}

const totalCount = platforms.length;
---
<Base>
  <!-- 1. Hero 区域 (双轨轮播: 01 探索者免费算力雷达 | 02 职业开发者算力实验室) -->
  <section class="hero-editorial" id="hero-editorial">
    <div class="container hero-editorial-inner">
      <div class="hero-copy">
        
        <!-- 搜索框：置顶在第一交互位 -->
        <div class="hero-search-wrap">
          <input
            type="text"
            id="search-input"
            class="hero-search-input"
            placeholder="搜索 29+ 家平台、模型（如 Gemini, GLM-4, DeepSeek, MiniMax）或特性..."
            autocomplete="off"
          />
        </div>

        <!-- 双轨模式切换器 (Segmented Switcher) -->
        <div class="hero-track-switcher">
          <button class="track-tab active" data-slide="0" id="tab-slide-0">
            <span class="track-num">01</span>
            <span>免费算力雷达</span>
          </button>
          <button class="track-tab" data-slide="1" id="tab-slide-1">
            <span class="track-num">02</span>
            <span>职业开发者 Lab ↗</span>
          </button>
          <div class="track-progress-bar">
            <div class="track-progress-inner" id="track-progress-inner"></div>
          </div>
        </div>

        <!-- 轮播幻灯片容器 -->
        <div class="hero-slides-wrapper">
          
          <!-- Slide 0: 免费算力雷达 (公益/思维/免费Token) -->
          <div class="hero-slide active" id="hero-slide-0">
            <p class="hero-eyebrow">一人公司 · AI 算力与开源情报</p>
            <h1 class="hero-headline">
              用免费 Token 做工具，<br/>
              也提醒自己保持思考。
            </h1>
            <p class="hero-lead">
              持续追踪全球主流大模型与云平台免费 API 配额，提供透明规则与 10 秒接入代码。
            </p>

            <!-- 极简中性仪表条 -->
            <div class="radar-telemetry-bar">
              <div class="telemetry-item">
                <span class="telemetry-label">监测节点</span>
                <span class="telemetry-value">{totalCount} / {totalCount} 正常</span>
              </div>
              <div class="telemetry-divider"></div>
              <div class="telemetry-item">
                <span class="telemetry-label">上次核验</span>
                <span id="telemetry-last-sweep" class="telemetry-value">今日 07:30</span>
              </div>
              <div class="telemetry-divider"></div>
              <div class="telemetry-item">
                <span class="telemetry-label">额度巡检</span>
                <span id="radar-live-countdown" class="telemetry-timer">--:--:--</span>
              </div>
              <div class="telemetry-divider"></div>
              <div class="telemetry-item">
                <span class="telemetry-label">新源雷达</span>
                <span id="radar-discover-countdown" class="telemetry-timer">--:--:--</span>
              </div>
            </div>

            <!-- 重点索引 -->
            <div class="quick-index-bar">
              <span class="quick-index-label">重点索引</span>
              <div class="quick-index-links">
                <a href="/platform/google-ai-studio/" class="quick-link">Google Gemini · 1500次/天</a>
                <a href="/platform/siliconflow/" class="quick-link">硅基流动 · 2000万Tokens</a>
                <a href="/platform/gmi-cloud-minimax/" class="quick-link">GMI Cloud · 20亿限时</a>
                <a href="/platform/groq/" class="quick-link">Groq · 极速推理</a>
              </div>
            </div>

            <div class="hero-actions">
              <a class="btn-hero-primary" href="#products">浏览全部资源库 ↓</a>
              <a class="btn-hero-secondary" href="#guide">查看接入指南 ↓</a>
              <button class="btn-hero-secondary open-wechat-trigger">关注公众号 ↗</button>
            </div>
          </div>

          <!-- Slide 1: 职业开发者实验室 (商业化/高可靠/freetokenlab.com) -->
          <div class="hero-slide" id="hero-slide-1">
            <p class="hero-eyebrow hero-eyebrow-lab">重度生产力 · 商业级高可用算力方案</p>
            <h1 class="hero-headline">
              我是职业开发者，<br/>
              我需要极具性价比的可靠 Token。
            </h1>
            <p class="hero-lead">
              面向严肃商业交付与自动化工程：提供国内可用、基于美国原生 Remote App 服务器的 Claude 3.5 Sonnet / Codex 极稳接入，以及国内主流大模型开发者专属采购折扣。
            </p>

            <!-- 商业级核心特性标签 -->
            <div class="lab-highlights-grid">
              <div class="lab-highlight-item">
                <span class="lab-highlight-badge">原生稳定</span>
                <span class="lab-highlight-text">Claude 3.5 Sonnet / Opus 美国原生防封直连通道</span>
              </div>
              <div class="lab-highlight-item">
                <span class="lab-highlight-badge">编程代理</span>
                <span class="lab-highlight-text">Codex & Cursor 生产级编程工具全天候低延迟</span>
              </div>
              <div class="lab-highlight-item">
                <span class="lab-highlight-badge">专属折扣</span>
                <span class="lab-highlight-text">国内主流大模型企业级底价采购与高并发池化</span>
              </div>
            </div>

            <div class="hero-actions">
              <a class="btn-hero-primary btn-hero-lab" href="https://freetokenlab.com" target="_blank" rel="noopener">
                前往 FreeToken Lab 探索职业算力 ↗
              </a>
              <a class="btn-hero-secondary" href="#guide">了解接入架构 ↓</a>
            </div>
          </div>

        </div>
      </div>

      <!-- 右侧吉祥物卡片 -->
      <div class="hero-mascot-wrapper">
        <div class="hero-card-mascot">
          <img src="/images/hero-mascot.webp" alt="思考的科技猫头鹰插画" class="hero-mascot-img" width="380" height="380" />
          <div class="mascot-caption">
            <p>工具让人走得更快，思考决定往哪里走。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 平台资源库 -->
  <section class="section-wrap section-bg" id="products">
    <div class="container">
      <header class="section-head">
        <p class="section-eyebrow">资源与实践</p>
        <h2 class="section-title">全网免费 API Token 清单与 10 秒接入代码</h2>
      </header>

      <!-- 分类过滤 Tab -->
      <div class="filter-pills" id="filter-tabs">
        <button class="filter-pill active" data-filter="all">全部平台 ({totalCount})</button>
        <button class="filter-pill" data-filter="limited">限时活动</button>
        <button class="filter-pill" data-filter="permanent">大厂基座</button>
        <button class="filter-pill" data-filter="daily">每日刷新</button>
        <button class="filter-pill" data-filter="domestic">国产直连</button>
        <button class="filter-pill" data-filter="tools">开发与搜索</button>
        <button class="filter-pill" data-filter="multimodal">多模态生图</button>
        <button class="filter-pill" data-filter="web3">测试网络</button>
      </div>

      <!-- 资源卡片网格 -->
      <div class="editorial-grid" id="platform-grid">
        {platforms.map((p) => {
          const q = p.free_quota ?? {};
          const isLimited = q.type === '注册赠送' || q.type === '限时赠送' || q.type === '体验金';
          const isPermanent = q.type === '永久免费' || q.type === '完全免费' || q.type === '免费层';
          const isDaily = q.type === '每日刷新' || (q.reset_period && q.reset_period.includes('日'));
          const isDomestic = p.category === '国内主流' || p.category === '大厂云服务';
          const isTools = p.category === '搜索与工具' || p.slug === 'tavily' || p.slug === 'jina-ai';
          const isMultimodal = p.category === '多模态/工具' || p.category === '多模态' || p.slug === 'pollinations';
          const isWeb3 = p.category === '区块链水龙头' || p.slug === 'sepolia-faucet';

          return (
            <a
              class="editorial-card"
              href={`/platform/${p.slug}/`}
              data-limited={isLimited ? "true" : "false"}
              data-permanent={isPermanent ? "true" : "false"}
              data-daily={isDaily ? "true" : "false"}
              data-domestic={isDomestic ? "true" : "false"}
              data-tools={isTools ? "true" : "false"}
              data-multimodal={isMultimodal ? "true" : "false"}
              data-web3={isWeb3 ? "true" : "false"}
              data-search={`${p.name} ${p.name_en ?? ''} ${p.slug} ${p.intro ?? ''}`.toLowerCase()}
            >
              <div class="card-main-content">
                <div class="card-meta-top">
                  <span class="card-category">{p.category}</span>
                  {isLimited && <span class="badge-tag badge-limited">限时</span>}
                  {isPermanent && <span class="badge-tag badge-permanent">永久</span>}
                  {isDaily && <span class="badge-tag badge-daily">每日</span>}
                </div>

                <h3 class="card-title">
                  {p.name}
                  {p.name_en && p.name !== p.name_en && <small class="card-name-en">{p.name_en}</small>}
                </h3>

                <div class="card-quota-box">
                  <div class="quota-label">核心免费额度</div>
                  <div class="quota-amount">{formatQuota(p)}</div>
                </div>

                <p class="card-intro">{p.intro}</p>
              </div>

              <div class="card-action-bar">
                <span class="action-date">核验：{formatVerified(p.last_verified)}</span>
                <span class="action-link">查看详情与代码 ➔</span>
              </div>
            </a>
          );
        })}
      </div>

      <div id="no-result" class="no-result-box" style="display:none;">
        <p style="font-size: 16px; font-weight: 600;">未找到匹配的平台</p>
        <p style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">建议更换关键词，或在 GitHub 提交 Issue 推荐新源</p>
      </div>
    </div>
  </section>

  <!-- 3. 工具实践与接入指南 -->
  <section class="section-wrap" id="guide">
    <div class="container">
      <header class="section-head">
        <p class="section-eyebrow">工具实践</p>
        <h2 class="section-title">如何将 FreeToken 免费资源接入 AI 工具与工作流？</h2>
      </header>

      <div class="guide-grid">
        <article class="guide-card">
          <div class="guide-card-head">
            <span class="guide-step">01</span>
            <h3>标准 OpenAI 协议兼容</h3>
          </div>
          <p class="guide-text">
            本站收录的大多数模型平台均原生支持 <strong>OpenAI REST API 标准接口</strong>。在任何工具或代码中，只需替换以下 <strong>3 个参数</strong>：
          </p>
          <div class="guide-param-list">
            <div class="guide-param"><code>Base URL</code> 各平台详情页标注的专用端点</div>
            <div class="guide-param"><code>API Key</code> 在平台控制台生成的私有密钥</div>
            <div class="guide-param"><code>Model Name</code> 对应的免费模型标识（如 gemini-1.5-flash, deepseek-chat）</div>
          </div>
        </article>

        <article class="guide-card">
          <div class="guide-card-head">
            <span class="guide-step">02</span>
            <h3>开源客户端与编程工具挂载</h3>
          </div>
          <ul class="guide-tool-list">
            <li>
              <strong>终端与编程工具</strong>：
              <a href="https://github.com/OpenCode-AI/opencode" target="_blank" rel="noopener" class="guide-repo-link">OpenCode ↗</a>、
              <a href="https://github.com/cline/cline" target="_blank" rel="noopener" class="guide-repo-link">Cline ↗</a> 或 Cursor，设置自定义 OpenAI Provider 填入 Base URL 与 Key 即可驱动编程 Agent。
            </li>
            <li>
              <strong>多模型桌面客户端</strong>：
              使用 <a href="https://github.com/CherryHQ/cherry-studio" target="_blank" rel="noopener" class="guide-repo-link">Cherry Studio ↗</a>、
              <a href="https://github.com/Bin-Huang/chatbox" target="_blank" rel="noopener" class="guide-repo-link">Chatbox ↗</a> 或 
              <a href="https://github.com/ChatGPTNextWeb/ChatGPT-Next-Web" target="_blank" rel="noopener" class="guide-repo-link">NextChat ↗</a> 可实现同屏多模型对比与多 Key 轮换调用。
            </li>
            <li>
              <strong>网关聚合与负载均衡</strong>：
              搭配 <a href="https://github.com/songquanpeng/one-api" target="_blank" rel="noopener" class="guide-repo-link">One API ↗</a> 或 
              <a href="https://github.com/Calcium-Affliction/new-api" target="_blank" rel="noopener" class="guide-repo-link">New API ↗</a>，将 29 家免费 Key 汇聚为高可用单一网关接口。
            </li>
          </ul>
        </article>

        <article class="guide-card">
          <div class="guide-card-head">
            <span class="guide-step">03</span>
            <h3>避坑与风控要点</h3>
          </div>
          <ul class="guide-caution-list">
            <li><strong>并发限制（RPM / TPM）</strong>：免费层通常有请求频次限制（如 15 RPM），请在代码中增加重试退避逻辑，避免 429 报错。</li>
            <li><strong>额度有效期</strong>：注意区分每日循环重置额度（如 Gemini 1500次/天）与一次性注册体验金（如 30 天有效），优先消耗有时效限制的额度。</li>
            <li><strong>区域与网络</strong>：部分海外平台需要合规国际网络访问，国内平台需要国内手机号或实名认证。</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. 四个长期坐标 -->
  <section class="section-wrap section-bg" id="focus">
    <div class="container">
      <header class="section-head">
        <p class="section-eyebrow">长期主义</p>
        <h2 class="section-title">四个长期坐标</h2>
      </header>

      <div class="focus-grid">
        <article class="focus-card">
          <div class="focus-card-top">
            <span class="focus-num">01</span>
            <img src="/images/focus-01.webp" alt="AI 引导未来" class="focus-card-art" loading="lazy" decoding="async" width="300" height="300" />
          </div>
          <div class="focus-card-meta">
            <span class="focus-en-tag">AI COMPASS</span>
            <h3 class="focus-title">AI 引导未来</h3>
            <p class="focus-desc">研究大模型、思考模式与人机协作范式。在算力浪潮中，保持独立判断与认知锚点。</p>
            <div class="focus-anchor-link">
              <a href="https://github.com/lm-sys/FastChat" target="_blank" rel="noopener">LMSYS Chatbot Arena 基准 ↗</a>
            </div>
          </div>
        </article>

        <article class="focus-card">
          <div class="focus-card-top">
            <span class="focus-num">02</span>
            <img src="/images/focus-02.webp" alt="Token 就是能源" class="focus-card-art" loading="lazy" decoding="async" width="300" height="300" />
          </div>
          <div class="focus-card-meta">
            <span class="focus-en-tag">TOKEN ENERGY</span>
            <h3 class="focus-title">Token 就是能源</h3>
            <p class="focus-desc">算力的流动即价值的流动。低成本、充沛的 Token 是数字世界一人公司的电力与能源主权。</p>
            <div class="focus-anchor-link">
              <a href="https://github.com/vllm-project/vllm" target="_blank" rel="noopener">vLLM 高并发推理引擎 ↗</a>
            </div>
          </div>
        </article>

        <article class="focus-card">
          <div class="focus-card-top">
            <span class="focus-num">03</span>
            <img src="/images/focus-03.webp" alt="世界代码化" class="focus-card-art" loading="lazy" decoding="async" width="300" height="300" />
          </div>
          <div class="focus-card-meta">
            <span class="focus-en-tag">CODIFIED REALITY</span>
            <h3 class="focus-title">世界代码化</h3>
            <p class="focus-desc">将研究、流程与思考沉淀为代码与自动化流水线。让软件成为扩展个人杠杆的最坚固底座。</p>
            <div class="focus-anchor-link">
              <a href="https://github.com/langgenius/dify" target="_blank" rel="noopener">Dify 开源应用编排 ↗</a>
            </div>
          </div>
        </article>

        <article class="focus-card">
          <div class="focus-card-top">
            <span class="focus-num">04</span>
            <img src="/images/focus-04.webp" alt="工具开源化" class="focus-card-art" loading="lazy" decoding="async" width="300" height="300" />
          </div>
          <div class="focus-card-meta">
            <span class="focus-en-tag">OPEN TOOLS</span>
            <h3 class="focus-title">工具开源化</h3>
            <p class="focus-desc">拥抱开放权重与公共协议。把核心能力构建在开放生态之上，掌握自主可控的创造力。</p>
            <div class="focus-anchor-link">
              <a href="https://huggingface.co/spaces/open-llm-leaderboard/open_llm_leaderboard" target="_blank" rel="noopener">Open LLM 开放榜单 ↗</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 5. 保持联系 -->
  <section class="section-wrap" id="community">
    <div class="container">
      <header class="section-head">
        <p class="section-eyebrow">保持联系</p>
        <h2 class="section-title">开放连接</h2>
      </header>

      <div class="connect-grid">
        <a class="connect-card open-wechat-trigger" href="javascript:void(0)">
          <div class="connect-card-top">
            <span class="connect-type">微信生态</span>
            <span class="connect-action">扫码关注 ↗</span>
          </div>
          <h4 class="connect-name">免费Token情报局</h4>
          <p class="connect-desc">突发限时免费配额、大厂羊毛与深度技术接入指南第一时间推送到微信。</p>
        </a>

        <a class="connect-card" href="https://github.com/kimhero110/freetoken" target="_blank" rel="noopener">
          <div class="connect-card-top">
            <span class="connect-type">开源仓库</span>
            <span class="connect-action">Star & Fork ↗</span>
          </div>
          <h4 class="connect-name">GitHub 代码库</h4>
          <p class="connect-desc">本项目完全开源，包含所有巡检雷达脚本、Astro 构建源码与数据源配置。</p>
        </a>

        <a class="connect-card" href="https://github.com/kimhero110/freetoken/issues/new?template=submit_platform.yml" target="_blank" rel="noopener">
          <div class="connect-card-top">
            <span class="connect-type">社区贡献</span>
            <span class="connect-action">提交 Issue ↗</span>
          </div>
          <h4 class="connect-name">推荐新免费源</h4>
          <p class="connect-desc">发现了新的大模型免费额度或限时活动？欢迎提交，全网雷达将收录并巡检。</p>
        </a>
      </div>
    </div>
  </section>

  <style>
    .section-wrap {
      padding: 72px 0;
      border-bottom: 1px solid var(--card-border);
    }
    .section-bg {
      background: var(--bg-subtle);
    }
    .section-head {
      margin-bottom: 36px;
    }
    .section-eyebrow {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--text-light);
      margin-bottom: 6px;
    }
    .section-title {
      font-size: 26px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.5px;
    }

    /* Hero Section */
    .hero-editorial {
      padding: 40px 0 56px;
      border-bottom: 1px solid var(--card-border);
      background: #fbfbfa;
      position: relative;
    }
    .hero-editorial-inner {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
      align-items: start;
    }
    .hero-copy {
      display: flex;
      flex-direction: column;
    }

    /* Hero Search Input */
    .hero-search-wrap {
      margin-bottom: 18px;
    }
    .hero-search-input {
      width: 100%;
      background: #ffffff;
      border: 1.5px solid var(--card-border);
      border-radius: 8px;
      padding: 12px 16px;
      font-size: 14px;
      color: var(--text);
      outline: none;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }
    .hero-search-input:focus {
      border-color: var(--text);
      box-shadow: 0 4px 14px rgba(0,0,0,0.06);
    }

    /* Track Switcher (Tabs) */
    .hero-track-switcher {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 4px;
      margin-bottom: 20px;
      width: fit-content;
      position: relative;
    }
    .track-tab {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 12.5px;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
