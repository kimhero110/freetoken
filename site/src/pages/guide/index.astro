---
import Base from '../../layouts/Base.astro';
import CodeGenerator from '../../components/CodeGenerator.astro';
import GuideArticles from '../../components/GuideArticles.astro';
import platforms from '../../data/platforms.json';
---

<Base 
  title="实战指南与 10 秒代码生成器 · 全球大模型与 OpenClaw 接入白皮书" 
  description="全网免费 API 交互式接入配置生成器与 6 大重磅实战长文。包含 4.5 亿 Tokens 算账模型、多 Key 聚合池网关搭建、5 小时滑动窗口避坑、OpenClaw 降本 90% 极客技巧与国内外大模型选型矩阵。"
  lang="zh"
  analytics={false}
>
  <section class="guide-hero-section">
    <div class="container">
      <div class="guide-hero-badge">PRACTICE PLAYBOOK · 开发者实战白皮书</div>
      <h1 class="guide-hero-title">全网免费 API 交互式接入配置生成器与实战指南</h1>
      <p class="guide-hero-desc">
        消除参数配置心智负担，系统化掌握大模型算力调度。上部提供 <strong>10 秒代码即时合成工具</strong>，下部涵盖 <strong>6 篇深度实战长文</strong>（算账模型、网关搭建、5小时滑动窗口机制、降本 90% 技巧与全网选型矩阵）。
      </p>

      <nav class="guide-toc-nav">
        <span class="toc-nav-label">目录速达：</span>
        <a href="#code-generator" class="toc-link">⚡ 10秒代码生成器</a>
        <a href="#art-01" class="toc-link">01 · OpenAI 协议</a>
        <a href="#art-02" class="toc-link">02 · 4.5亿算账</a>
        <a href="#art-03" class="toc-link">03 · 多Key网关</a>
        <a href="#art-04" class="toc-link">04 · 滑动窗口</a>
        <a href="#art-05" class="toc-link">05 · 降本90%</a>
        <a href="#art-06" class="toc-link">06 · 选型矩阵</a>
      </nav>
    </div>
  </section>

  <section class="section-wrap">
    <div class="container">
      <CodeGenerator platforms={platforms} lang="zh" />
    </div>
  </section>

  <GuideArticles lang="zh" />

  <style>
    .guide-hero-section {
      padding: 48px 0 24px;
      border-bottom: 1px solid var(--card-border);
      background: #ffffff;
    }
    .guide-hero-badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.6px;
      color: var(--accent);
      background: rgba(37, 99, 235, 0.08);
      border: 1px solid rgba(37, 99, 235, 0.2);
      padding: 3px 10px;
      border-radius: 4px;
      margin-bottom: 14px;
    }
    .guide-hero-title {
      font-size: clamp(22px, 3.8vw, 34px);
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.6px;
      margin-bottom: 14px;
      line-height: 1.25;
    }
    .guide-hero-desc {
      font-size: 14.5px;
      color: var(--text-muted);
      max-width: 820px;
      line-height: 1.7;
      margin-bottom: 20px;
    }
    .guide-toc-nav {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      font-size: 12.5px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 4px;
    }
    .toc-nav-label {
      font-weight: 700;
      color: var(--text);
    }
    .toc-link {
      color: var(--text-muted);
      border: 1px solid var(--card-border);
      background: var(--bg-subtle);
      padding: 3px 10px;
      border-radius: 4px;
      white-space: nowrap;
      transition: all 0.15s;
    }
    .toc-link:hover {
      color: var(--text);
      border-color: var(--text);
    }
    .section-wrap {
      padding: 36px 0 0;
    }
  </style>
</Base>
