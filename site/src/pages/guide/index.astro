export ANTHROPIC_API_KEY="YOUR_${p.slug.toUpperCase().replace(/-/g, '_')}_API_KEY"
export ANTHROPIC_MODEL="${modelName}"

# 启动 Claude Code 编程代理
claude`;
      } else if (selectedTool === 'cursor') {
        filename = 'Cursor_Settings.txt';
        tag = '适用于 Cursor / Cline / OpenCode';
        code = `【Cursor / Cline / OpenCode IDE 接入指南】

1. 打开 Cursor / VS Code 设置 -> Models -> OpenAI API Key
2. 勾选 "Override OpenAI Base URL" 并填入：
   Base URL: ${baseUrl}
3. 填入你的 API Key:
   API Key: YOUR_API_KEY
4. 在模型列表中点击 "+ Add Model" 新增模型名称：
   Model Name: ${modelName}
5. 点击 Save 即可开始在编辑器内享受 AI 编程与 Agent 代码补全！`;
      } else if (selectedTool === 'cherry') {
        filename = 'cherry_provider.json';
        tag = '适用于 Cherry Studio / Chatbox';
        code = `{
  "id": "${p.slug}",
  "name": "${pName}",
  "apiType": "openai",
  "baseUrl": "${baseUrl}",
  "apiKey": "sk-xxxxxxxxxxxxxxxx",
  "models": [
    {
      "id": "${modelName}",
      "name": "${modelName}"
    }
  ]
}`;
      } else if (selectedTool === 'freellmapi') {
        filename = 'freellmapi_pool.sh';
        tag = '适用于 FreeLLMAPI / One API 多 Key 聚合池';
        code = `# 1. 克隆轻量级开源网关 FreeLLMAPI
git clone https://github.com/tashfeenahmed/freellmapi.git && cd freellmapi
npm install

# 2. 注入 ${pName} 作为高可用上游通道
# Base URL: ${baseUrl}
# Model: ${modelName}

# 3. 启动并开启智能自动降级 (Fallback Chain)
npm run dev
# 访问 http://localhost:3001 查看统一聚合端点，支持单 Key 畅调！`;
      } else if (selectedTool === 'python') {
        filename = 'test_llm.py';
        tag = '适用于 Python / OpenAI SDK';
        code = `from openai import OpenAI

# 初始化 ${pName} 客户端
client = OpenAI(
    base_url="${baseUrl}",
    api_key="YOUR_API_KEY"
)

response = client.chat.completions.create(
    model="${modelName}",
    messages=[
        {"role": "system", "content": "你是由 ${pName} 驱动的专业智能助手。"},
        {"role": "user", "content": "你好！请用一句话介绍你最强大的特性。"}
    ],
    temperature=0.7
)

print(response.choices[0].message.content)`;
      } else if (selectedTool === 'curl') {
        filename = 'test_curl.sh';
        tag = '适用于 Linux / macOS / WSL 终端';
        code = `curl -X POST "${baseUrl}/chat/completions" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_API_KEY" \
  -d '{
    "model": "${modelName}",
    "messages": [
      {"role": "user", "content": "Hello, please reply in one sentence."}
    ],
    "stream": false
  }'`;
      }

      if (codeSnippetEl) codeSnippetEl.textContent = code;
      if (codeFilenameEl) codeFilenameEl.textContent = filename;
      if (codeTagEl) codeTagEl.textContent = tag;
    }

    toolPills.forEach(pill => {
      pill.addEventListener('click', () => {
        toolPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        selectedTool = pill.getAttribute('data-tool') || 'openclaw';
        renderGeneratedCode();
      });
    });

    platformSelect?.addEventListener('change', (e) => {
      selectedPlatformSlug = e.target.value;
      renderGeneratedCode();
    });

    btnCopyCode?.addEventListener('click', () => {
      const code = codeSnippetEl?.textContent || '';
      navigator.clipboard.writeText(code).then(() => {
        if (copyBtnText) copyBtnText.textContent = '已复制到剪贴板 ✓';
        btnCopyCode.style.background = '#2563eb';
        btnCopyCode.style.color = '#ffffff';
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = '一键复制代码';
          btnCopyCode.style.background = '';
          btnCopyCode.style.color = '';
        }, 2000);
      });
    });

    renderGeneratedCode();
  </script>
</Base>
