---
interface Props {
  title?: string;
  description?: string;
  lang?: 'zh' | 'en';
  currentSlug?: string;
  analytics?: boolean;
  localized?: boolean;
}

const {
  title,
  description,
  lang = 'zh',
  currentSlug,
  analytics = true,
  localized = true,
} = Astro.props;

const isEn = lang === 'en';

const defaultTitle = isEn
  ? 'FreeToken · Global LLM & Cloud API Free Tier Intelligence'
  : 'FreeToken · 免费 Token 情报局 | 全球主流大模型免费 API 配额与接入指南';

const defaultDesc = isEn
  ? 'Curated free API tiers and token credits across 40+ global LLM platforms. 10-second setup code and gotchas.'
  : '聚合全球主流大模型（LLM）与云平台的免费 API 额度与白嫖配额。实时雷达探测巡检，提供透明规则与 10 秒即用代码。';

const pageTitle = title ? `${title} | FreeToken` : defaultTitle;
const pageDesc = description || defaultDesc;
const canonicalUrl = new URL(Astro.url.pathname, 'https://freetokens.info').toString();

// Alternate switch link
let switchUrl = '/';
const currentPath = Astro.url.pathname;
if (!localized) {
  switchUrl = isEn ? '/articles/' : '/en/articles/';
} else if (isEn) {
  if (currentSlug) {
    switchUrl = `/platform/${currentSlug}/`;
  } else if (currentPath.includes('/article/')) {
    const slug = currentPath.split('/article/')[1].replace(/\//g, '');
    switchUrl = `/article/${slug}/`;
  } else if (currentPath.includes('/articles')) {
    switchUrl = '/articles/';
  } else if (currentPath.includes('/guide')) {
    switchUrl = '/guide/';
  } else if (currentPath.includes('/about')) {
    switchUrl = '/about/';
  } else {
    switchUrl = '/';
  }
} else {
  if (currentSlug) {
    switchUrl = `/en/platform/${currentSlug}/`;
  } else if (currentPath.includes('/article/')) {
    const slug = currentPath.split('/article/')[1].replace(/\//g, '');
    switchUrl = `/en/article/${slug}/`;
  } else if (currentPath.includes('/articles')) {
    switchUrl = '/en/articles/';
  } else if (currentPath.includes('/guide')) {
    switchUrl = '/en/guide/';
  } else if (currentPath.includes('/about')) {
    switchUrl = '/en/about/';
  } else {
    switchUrl = '/en/';
  }
}
---
<!DOCTYPE html>
<html lang={isEn ? 'en' : 'zh-CN'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />

  <!-- Open Graph / Meta -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content="/images/hero-mascot.webp" />
  <meta property="og:url" content={canonicalUrl} />

  <!-- Canonical & hreflang SEO -->
  <link rel="canonical" href={canonicalUrl} />
  {localized && <link rel="alternate" hreflang="zh-CN" href={new URL(isEn ? switchUrl : currentPath, 'https://freetokens.info').toString()} />}
  {localized && <link rel="alternate" hreflang="en" href={new URL(isEn ? currentPath : switchUrl, 'https://freetokens.info').toString()} />}
  {localized && <link rel="alternate" hreflang="x-default" href={new URL(isEn ? switchUrl : currentPath, 'https://freetokens.info').toString()} />}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Umami Private Analytics (Dynamic routing for freetokens.info & witkit.zone) -->
  {analytics && <script is:inline>
    (function() {
      try {
        var h = window.location.hostname || '';
        var wid = (h.indexOf('witkit.zone') !== -1)
          ? '0a887fe2-61cb-4bc6-8480-e8de3e4be328'
          : 'cd161655-a597-4450-acb9-30397e390c54';
        var s = document.createElement('script');
        s.defer = true;
        s.src = 'https://analytics.witkit.zone/script.js';
        s.setAttribute('data-website-id', wid);
        document.head.appendChild(s);
      } catch (e) {}
    })();
  </script>}

  <style is:global>
    :root {
      --bg: #fbfbfa;
      --bg-subtle: #f4f3ef;
      --text: #1a1a19;
      --text-muted: #57564f;
      --text-light: #8c8b82;
      --accent: #2563eb;
      --card-border: #e7e5e0;
      --font-serif: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-serif);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: 100%;
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* 顶部导航 */
    .site-header {
      border-bottom: 1px solid var(--card-border);
      background: rgba(251, 251, 250, 0.95);
      backdrop-filter: blur(8px);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 56px;
    }
    .brand-logo {
      display: flex;
      align-items: baseline;
      gap: 6px;
      font-weight: 800;
      font-size: 16.5px;
      letter-spacing: -0.4px;
      color: var(--text);
      white-space: nowrap;
    }
    .brand-badge {
      font-size: 10.5px;
      font-weight: 600;
      color: var(--accent);
      border: 1px solid rgba(37, 99, 235, 0.2);
      padding: 1px 6px;
      border-radius: 4px;
      background: rgba(37, 99, 235, 0.06);
    }

    /* 桌面端导航 */
    .nav-desktop-links {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .nav-item {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      white-space: nowrap;
      transition: color 0.15s ease;
    }
    .nav-item:hover {
      color: var(--text);
    }

    /* 语言切换胶囊 */
    .nav-lang-switch {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text);
      border: 1px solid var(--card-border);
      background: #ffffff;
      padding: 5px 10px;
      border-radius: 6px;
      white-space: nowrap;
      transition: all 0.15s;
    }
    .nav-lang-switch:hover {
      border-color: var(--text);
      background: var(--bg-subtle);
    }

    /* 微信按钮 */
    .nav-btn-wechat {
      background: transparent;
      border: 1px solid var(--card-border);
      color: var(--text);
      font-size: 13px;
      font-weight: 600;
      padding: 5px 11px;
      border-radius: 6px;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .nav-btn-wechat:hover {
      border-color: var(--text);
      background: #ffffff;
    }

    .nav-github-link {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      border: 1px solid var(--card-border);
      padding: 5px 11px;
      border-radius: 6px;
      white-space: nowrap;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .nav-github-link:hover {
      border-color: var(--text);
      color: var(--text);
      background: #ffffff;
    }

    /* 移动端汉堡菜单触发按钮 */
    .mobile-nav-right {
      display: none;
      align-items: center;
      gap: 8px;
    }
    .btn-hamburger {
      width: 40px;
      height: 40px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #ffffff;
      border: 1px solid var(--card-border);
      border-radius: 6px;
      font-size: 18px;
      cursor: pointer;
      color: var(--text);
    }

    /* 移动端抽屉菜单 (Mobile Drawer) */
    .mobile-drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(4px);
      z-index: 999;
      display: none;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .mobile-drawer-backdrop.open {
      display: block;
      opacity: 1;
    }
    .mobile-drawer-panel {
      position: fixed;
      top: 0;
      right: 0;
      width: 80%;
      max-width: 320px;
      height: 100vh;
      background: #ffffff;
      border-left: 1px solid var(--card-border);
      z-index: 1000;
      transform: translateX(100%);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      box-shadow: -10px 0 30px rgba(0,0,0,0.1);
      padding: 20px;
    }
    .mobile-drawer-panel.open {
      transform: translateX(0);
    }
    .drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--card-border);
      padding-bottom: 16px;
      margin-bottom: 20px;
    }
    .drawer-title {
      font-size: 16px;
      font-weight: 800;
      color: var(--text);
    }
    .btn-drawer-close {
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      border-radius: 6px;
      font-size: 18px;
      cursor: pointer;
      color: var(--text);
    }
    .drawer-nav-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 28px;
    }
    .drawer-nav-item {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      padding: 10px 14px;
      border-radius: 8px;
      background: var(--bg-subtle);
      border: 1px solid var(--card-border);
      display: flex;
      align-items: center;
      gap: 10px;
      white-space: nowrap;
    }
    .drawer-nav-item:active {
      background: #ffffff;
      border-color: var(--accent);
    }
    .drawer-footer-actions {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
      border-top: 1px solid var(--card-border);
      padding-top: 20px;
    }
    .btn-drawer-wechat {
      width: 100%;
      background: #07c160;
      color: #ffffff;
      border: none;
      font-size: 14px;
      font-weight: 700;
      padding: 12px;
      border-radius: 8px;
      cursor: pointer;
      text-align: center;
    }
    .btn-drawer-gh {
      width: 100%;
      background: var(--text);
      color: #ffffff;
      border: none;
      font-size: 14px;
      font-weight: 700;
      padding: 12px;
      border-radius: 8px;
      cursor: pointer;
      text-align: center;
    }

    /* 移动端断点响应式切换 */
    @media (max-width: 768px) {
      .nav-desktop-links {
        display: none;
      }
      .mobile-nav-right {
        display: flex;
      }
    }

    /* 页脚 */
    .site-footer {
      border-top: 1px solid var(--card-border);
      background: var(--bg-subtle);
      padding: 44px 0 28px;
      margin-top: auto;
      font-size: 13px;
      color: var(--text-muted);
    }
    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 28px;
    }
    .footer-brand h4 {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 6px;
    }
    .footer-brand p {
      max-width: 480px;
      line-height: 1.6;
      font-size: 13px;
    }
    .footer-links {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }
    .footer-ecosystem {
      border-top: 1px solid var(--card-border);
      margin-top: 24px;
      padding-top: 16px;
      display: flex;
      gap: 14px;
      align-items: center;
      flex-wrap: wrap;
      font-size: 12px;
      color: var(--text-light);
    }
    .footer-bottom {
      border-top: 1px solid var(--card-border);
      margin-top: 20px;
      padding-top: 20px;
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: var(--text-light);
      flex-wrap: wrap;
      gap: 12px;
    }

    /* 微信弹窗 */
    .wechat-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 16px;
    }
    .wechat-modal-backdrop.open {
      display: flex;
    }
    .wechat-modal-card {
      background: #ffffff;
      border: 1px solid var(--card-border);
      border-radius: 12px;
      width: 100%;
      max-width: 340px;
      padding: 24px 20px;
      text-align: center;
      position: relative;
      box-shadow: 0 20px 40px -15px rgba(0,0,0,0.12);
    }
    .modal-close-btn {
      position: absolute;
      top: 12px;
      right: 12px;
      background: transparent;
      border: none;
      font-size: 22px;
      line-height: 1;
      color: var(--text-muted);
      cursor: pointer;
      width: 32px;
      height: 32px;
    }
    .modal-qrcode-img {
      width: 160px;
      height: 160px;
      object-fit: contain;
      margin: 14px auto;
      display: block;
      border: 1px solid var(--card-border);
      border-radius: 8px;
    }
    .modal-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 6px;
    }
    .modal-desc {
      font-size: 12.5px;
      color: var(--text-muted);
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href={isEn ? '/en/' : '/'} class="brand-logo">
        <span>FreeTokens.info</span>
        <span class="brand-badge">{isEn ? 'Radar' : '情报局'}</span>
      </a>

      <!-- 桌面端横排导航 (>=768px) -->
      <nav class="nav-desktop-links">
        <a href={isEn ? '/en/' : '/'} class="nav-item">{isEn ? '⚡ Radar' : '⚡ 算力雷达'}</a>
        <a href={isEn ? '/en/articles/' : '/articles/'} class="nav-item">{isEn ? '📚 Articles' : '📚 深度文章'}</a>
        <a href={isEn ? '/en/guide/' : '/guide/'} class="nav-item">{isEn ? '📖 Playbook' : '📖 接入指南'}</a>
        <a href={isEn ? '/en/about/' : '/about/'} class="nav-item">{isEn ? '🧭 Philosophy' : '🧭 长期主义'}</a>
        
        <a href={switchUrl} class="nav-lang-switch" title={isEn ? 'Switch to Chinese' : '切换至英文版'}>
          {isEn ? '🇨🇳 中文' : '🌐 English'}
        </a>

        {!isEn && (
          <button class="nav-btn-wechat" id="btn-open-wechat">
            <span>公众号</span>
          </button>
        )}

        <a class="nav-github-link" href="https://github.com/kimhero110/freetoken" target="_blank" rel="noopener">
          <span>GitHub</span>
        </a>
      </nav>

      <!-- 移动端精简栏 (<768px: 语言切换 + 汉堡按钮) -->
      <div class="mobile-nav-right">
        <a href={switchUrl} class="nav-lang-switch" title={isEn ? 'Switch to Chinese' : '切换至英文版'}>
          {isEn ? '🇨🇳' : '🌐'}
        </a>
        <button class="btn-hamburger" id="btn-open-drawer" aria-label="Open Navigation Menu">
          <span>☰</span>
        </button>
      </div>
    </div>
  </header>

  <!-- 移动端侧滑抽屉菜单 -->
  <div class="mobile-drawer-backdrop" id="drawer-backdrop"></div>
  <div class="mobile-drawer-panel" id="drawer-panel">
    <div class="drawer-header">
      <span class="drawer-title">FreeTokens 导航</span>
      <button class="btn-drawer-close" id="btn-close-drawer">&times;</button>
    </div>

    <nav class="drawer-nav-list">
      <a href={isEn ? '/en/' : '/'} class="drawer-nav-item">
        <span>⚡</span>
        <span>{isEn ? 'Radar (Home)' : '算力雷达 (首页)'}</span>
      </a>
      <a href={isEn ? '/en/articles/' : '/articles/'} class="drawer-nav-item">
        <span>📚</span>
        <span>{isEn ? 'Articles Hub' : '深度文章专栏'}</span>
      </a>
      <a href={isEn ? '/en/guide/' : '/guide/'} class="drawer-nav-item">
        <span>📖</span>
        <span>{isEn ? 'Playbook & Generator' : '接入指南与生成器'}</span>
      </a>
      <a href={isEn ? '/en/about/' : '/about/'} class="drawer-nav-item">
        <span>🧭</span>
        <span>{isEn ? 'Philosophy' : '长期主义理念'}</span>
      </a>
    </nav>

    <div class="drawer-footer-actions">
      {!isEn && (
        <button class="btn-drawer-wechat" id="btn-drawer-wechat-action">
          <span>💬 关注官方公众号</span>
        </button>
      )}
      <a class="btn-drawer-gh" href="https://github.com/kimhero110/freetoken" target="_blank" rel="noopener">
        <span>⭐ GitHub 仓库 ↗</span>
      </a>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand">
          <h4>FreeTokens.info · {isEn ? 'Free Token Intelligence Bureau' : '免费Token情报局'}</h4>
          <p>
            {isEn
              ? 'Tracking global LLM & Cloud API free tiers, gotchas, and 10-second integration code for indie hackers, developers, and AI researchers.'
              : '持续追踪全球主流大模型与云平台免费 API 配额，为独立开发者与 AI 爱好者提供清晰、透明、可复用的接入指南。'}
          </p>
        </div>
        <div class="footer-links">
          <a href={isEn ? '/en/' : '/'}>{isEn ? 'Radar' : '算力雷达'}</a>
          <a href={isEn ? '/en/articles/' : '/articles/'}>{isEn ? 'Articles' : '深度文章'}</a>
          <a href={isEn ? '/en/guide/' : '/guide/'}>{isEn ? 'Playbook' : '接入指南'}</a>
          <a href={isEn ? '/en/about/' : '/about/'}>{isEn ? 'Philosophy' : '长期主义'}</a>
          <a href="/sitemap.xml" target="_blank">Sitemap</a>
          <a href="https://github.com/kimhero110/freetoken/issues/new?template=submit_platform.yml" target="_blank">{isEn ? 'Submit Tier' : '推荐新源'}</a>
          <a href="https://github.com/kimhero110/freetoken" target="_blank">GitHub</a>
        </div>
      </div>
      <div class="footer-ecosystem">
        <span>{isEn ? 'Ecosystem & Infra:' : '生态基础设施：'}</span>
        <a href="https://github.com/withastro/astro" target="_blank" rel="noopener">Astro Engine ↗</a>
        <a href="https://github.com/BerriAI/litellm" target="_blank" rel="noopener">LiteLLM Gateway ↗</a>
        <a href="https://github.com/openai/openai-python" target="_blank" rel="noopener">OpenAI Python SDK ↗</a>
        <a href="https://github.com/langgenius/dify" target="_blank" rel="noopener">Dify Platform ↗</a>
      </div>
      <div class="footer-bottom">
        <div>© 2026 FreeTokens.info · MIT License · Open Source Intelligence <span id="footer-icp-slot" style="display: none;"><span style="margin: 0 6px; opacity: 0.4;">|</span><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener" style="color: inherit; text-decoration: underline;">苏ICP备2026003689号-2</a></span></div>
        <div>Continuous Radar Sweeps across 40+ LLM Providers</div>
      </div>
    </div>
  </footer>

  <!-- 微信关注弹窗 -->
  <div class="wechat-modal-backdrop" id="wechat-modal">
    <div class="wechat-modal-card">
      <button class="modal-close-btn" id="btn-close-wechat">&times;</button>
      <h3 class="modal-title">关注【FreeToken 免费情报局】</h3>
      <p class="modal-desc">扫码关注官方公众号，第一时间接收全网大模型免费额度变动、新源上线与 Agent 降本内参。</p>
      <img src="/wechat-qrcode.jpg" alt="FreeToken 官方公众号二维码" class="modal-qrcode-img" />
      <p class="modal-desc" style="font-size: 11.5px; color: var(--text-light);">微信扫一扫 · 极客同行</p>
    </div>
  </div>

  <script is:inline>
    // 微信弹窗逻辑
    const wechatModal = document.getElementById('wechat-modal');
    const openWechatBtns = [
      document.getElementById('btn-open-wechat'),
      document.getElementById('btn-drawer-wechat-action')
    ];
    const closeWechatBtn = document.getElementById('btn-close-wechat');

    openWechatBtns.forEach(btn => {
      btn?.addEventListener('click', () => {
        wechatModal?.classList.add('open');
        closeDrawer();
      });
    });

    closeWechatBtn?.addEventListener('click', () => {
      wechatModal?.classList.remove('open');
    });

    wechatModal?.addEventListener('click', (e) => {
      if (e.target === wechatModal) {
        wechatModal.classList.remove('open');
      }
    });

    // 移动端侧滑抽屉逻辑
    const openDrawerBtn = document.getElementById('btn-open-drawer');
    const closeDrawerBtn = document.getElementById('btn-close-drawer');
    const drawerBackdrop = document.getElementById('drawer-backdrop');
    const drawerPanel = document.getElementById('drawer-panel');

    function openDrawer() {
      drawerBackdrop?.classList.add('open');
      drawerPanel?.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawerBackdrop?.classList.remove('open');
      drawerPanel?.classList.remove('open');
      document.body.style.overflow = '';
    }

    openDrawerBtn?.addEventListener('click', openDrawer);
    closeDrawerBtn?.addEventListener('click', closeDrawer);
    drawerBackdrop?.addEventListener('click', closeDrawer);
  
    // 域名检测：如果是国内腾讯云域名 witkit.zone，自动激活 ICP 备案标识
    if (window.location.hostname.includes('witkit.zone') || window.location.hostname.includes('124.221.254.56')) {
      const icpSlot = document.getElementById('footer-icp-slot');
      if (icpSlot) icpSlot.style.display = 'inline';
    }
  </script>
</body>
</html>
