/*
  X-Robots-Tag: all
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.witkit.zone; connect-src 'self' https://analytics.witkit.zone; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: all

/robots.txt
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: all
